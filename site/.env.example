# Public site only. Never commit real secrets.
# Copy to .env if you need local overrides.

# Book a Call form POST endpoint (Formspree, HubSpot, serverless, etc.)
# Example: https://formspree.io/f/xxxxxx
PUBLIC_BOOKING_ENDPOINT=

# Google Analytics measurement ID (G-XXXXXXXX). Leave empty to keep analytics absent.
PUBLIC_ANALYTICS_ID=

# Google Search Console verification token. Leave empty if unused.
PUBLIC_SEARCH_CONSOLE_VERIFICATION=
