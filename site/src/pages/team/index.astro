---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../config/site";

const members = await getCollection("team");
const title = `Team — ${SITE_NAME}`;
const description =
  "Dori Fussmann founded Rupert to bring the discipline of institutional dealmaking to founder-led fundraising.";
---

<BaseLayout title={title} description={description} canonicalPath="/team/">
  <main class="site-wrap flex-1 py-xl lg:py-2xl">
    <h1 class="type-h1">Team</h1>
    {
      members.map((member) => (
        <section
          id={member.data.slug}
          class="rule mt-2xl grid gap-lg pt-xl md:grid-cols-[10rem_1fr] md:gap-xl"
        >
          <h2 class="type-h2 md:col-span-2">{member.data.name}</h2>
          <Image
            class="photo h-auto w-32 md:w-40"
            src={member.data.photo}
            alt={`Photo of ${member.data.name}`}
            width={200}
            height={200}
            loading="lazy"
          />
          <div class="max-w-prose">
            <p class="type-label">{member.data.role}</p>
            <p class="type-body mt-md">{member.data.bio}</p>
            {member.data.credentials && (
              <p class="type-body-sm mt-sm">{member.data.credentials}</p>
            )}
            {member.data.sameAs.length > 0 && (
              <ul class="mt-lg">
                {member.data.sameAs.map((url) => (
                  <li>
                    <a class="break-all" href={url} rel="noopener noreferrer">
                      {url}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>
      ))
    }
  </main>
</BaseLayout>
