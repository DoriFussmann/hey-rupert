---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { sitePath } from "../../lib/url";
import howItWorks1 from "../../assets/how-it-works/how-it-works-01.png";
import howItWorks2 from "../../assets/how-it-works/how-it-works-02.png";
import howItWorks3 from "../../assets/how-it-works/how-it-works-03.png";
import howItWorks4 from "../../assets/how-it-works/how-it-works-04.png";
import howItWorks5 from "../../assets/how-it-works/how-it-works-05.png";

const title = "How Rupert Runs Investor Outreach | Rupert";
const description =
  "See how Rupert researches investors, builds personalized outreach, manages follow-up and keeps founders in control of every investor relationship.";

const steps = [
  {
    title: "Understand the raise",
    body: "Company, capital needs, story, current materials and target profile. A direct conversation with Dori about where you are and what has already been tried.",
    src: howItWorks1,
    alt: "Two people in conversation across a table, a notebook open between them",
  },
  {
    title: "Research and match",
    body: "Build the target investor universe using stage, vertical, geography, check size and investment criteria.",
    src: howItWorks2,
    alt: "A printed investor outreach list on a desk, a few names already marked",
  },
  {
    title: "Build the outreach",
    body: "Develop campaign positioning, message variants and sequence. Messages are written for the company and the investors receiving them.",
    src: howItWorks3,
    alt: "Printed email drafts overlapping on a desk, a pen beside them",
  },
  {
    title: "Approve and launch",
    body: "You review and approve messaging before launch. Rupert then manages execution and follow-up.",
    src: howItWorks4,
    alt: "A marked-up fundraising document on a desk beside a face-down phone",
  },
  {
    title: "Manage engagement",
    body: "Every reply goes to you. Rupert remains available to support prioritization and investor conversations as they develop.",
    src: howItWorks5,
    alt: "Two people at a small table with papers, in a working conversation",
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/how-it-works/">
  <main id="main-content" class="flex-1">
    <section class="site-wrap pb-xl pt-2xl lg:pb-2xl lg:pt-3xl">
      <p class="type-label">How it works</p>
      <h1 class="type-h1 mt-md">How Rupert runs investor outreach.</h1>
      <p class="type-body-lg mt-lg max-w-prose">
        Research, targeting, writing, follow-up and pipeline support — handled
        by an operator, with you remaining in control of every conversation.
      </p>
    </section>

    <ol class="site-wrap process-list pb-2xl">
      {
        steps.map((step, index) => (
          <li class="process-item process-item--media">
            <p class="step-num">
              {String(index + 1).padStart(2, "0")}
            </p>
            <div>
              <h2 class="type-h2">{step.title}</h2>
              <p class="type-body mt-md">{step.body}</p>
            </div>
            <div class="media-frame media-frame--square">
              <Image
                class="photo"
                src={step.src}
                alt={step.alt}
                widths={[480, 720, 960]}
                sizes="(min-width: 768px) 30vw, 92vw"
              />
            </div>
          </li>
        ))
      }
    </ol>

    <p class="site-wrap pb-2xl">
      <a class="btn-primary" href={sitePath("/book-call/")}>Book a call</a>
    </p>
  </main>
  <CtaBanner />
</BaseLayout>
