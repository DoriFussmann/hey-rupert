---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { sitePath } from "../../lib/url";
import howItWorks1 from "../../assets/how-it-works/how-it-works-01.png";
import howItWorks2 from "../../assets/how-it-works/how-it-works-02.png";
import howItWorks5 from "../../assets/how-it-works/how-it-works-05.png";

const title = "How Rupert Runs Investor Outreach, Step by Step | Rupert";
const description =
  "Rupert runs investor outreach in three stages: research and targeting, a campaign you approve, and follow-up. You own every investor relationship.";

const pillars: {
  title: string;
  summary: string;
  src: ImageMetadata;
  alt: string;
  stages: {
    title: string;
    body: string;
    linkHref?: string;
    linkLabel?: string;
  }[];
}[] = [
  {
    title: "Discovery & Strategy",
    summary:
      "Map the raise and research the investors who fit before a message is written.",
    src: howItWorks1,
    alt: "Two people in conversation across a table, a notebook open between them",
    stages: [
      {
        title: "Understand the Raise",
        body: "It starts with a direct conversation with Dori: the company, the story, the round, traction, and what has already been tried. The point is to see what makes the company fundable and where investor outreach should concentrate.",
        linkHref: "/about/",
        linkLabel: "Dori",
      },
      {
        title: "Build the Investor Universe",
        body: "Rupert builds a target list from its proprietary investor database, filtered by thesis, stage, sector, geography, check size, and mandate. Names are chosen for fit with this company and this raise.",
        linkHref: "/database/",
        linkLabel: "proprietary investor database",
      },
      {
        title: "Develop the Strategy",
        body: "Positioning, investor segments, and messaging are set around the company and the raise before any outreach is written. A seed-stage fund and a family office are different conversations, and the strategy treats them that way.",
      },
    ],
  },
  {
    title: "Campaign Launch",
    summary:
      "Write personalized outreach, get your approval, then run the campaign and the follow-up.",
    src: howItWorks2,
    alt: "A printed investor outreach list on a desk, a few names already marked",
    stages: [
      {
        title: "Craft the Outreach",
        body: "Messages are written for your company and tailored to each investor audience: the proof points and the follow-ups that match how that investor decides. This is not one sequence with the company name swapped in.",
      },
      {
        title: "Review & Approve",
        body: "You review the strategy, the target list, and the messaging before anything is sent. Nothing goes out without your approval. Rupert does the work; you decide how the company is presented.",
      },
      {
        title: "Launch & Follow Up",
        body: "Once you approve it, Rupert runs the campaign and the follow-up. Sequencing and timing sit with Rupert. Replies come to you, and the investor relationships stay yours.",
      },
    ],
  },
  {
    title: "Meetings & Momentum",
    summary:
      "Turn replies into the right conversations. You own every investor relationship.",
    src: howItWorks5,
    alt: "Two people at a small table with papers, in a working conversation",
    stages: [
      {
        title: "Qualify the Interest",
        body: "Every response is visible to you. Rupert helps sort real interest from noise so time goes to the conversations that fit the raise.",
      },
      {
        title: "Prepare for Meetings",
        body: "When a meeting is worth taking, the story is sharpened for that investor: likely questions, the proof points that matter, and what their mandate suggests they will ask.",
      },
      {
        title: "Manage the Process",
        body: "Rupert stays on follow-ups and next steps so the process keeps moving. Investor relationships remain yours. Dori can help manage the process without sitting between you and the investor.",
      },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/how-it-works/">
  <main id="main-content" class="flex-1">
    <section class="site-wrap pb-xl pt-2xl lg:pb-2xl lg:pt-3xl">
      <p class="type-label">How it works</p>
      <h1 class="type-h1 mt-md">How Rupert runs investor outreach.</h1>
      <p class="type-body-lg mt-lg max-w-prose">
        Three stages: investor research and targeting, personalized outreach you
        approve, and follow-up. You own every investor relationship.
      </p>
    </section>

    {
      pillars.map((pillar, index) => (
        <section
          class="site-wrap work-pillar section-block rule"
          aria-labelledby={`pillar-${index + 1}`}
        >
          <div class="work-pillar__intro">
            <div>
              <p class="step-script">Step {index + 1}</p>
              <h2 id={`pillar-${index + 1}`} class="type-h2 mt-md">
                {pillar.title}
              </h2>
              <p class="type-body-lg mt-md max-w-prose">{pillar.summary}</p>
            </div>
            <div class="media-frame">
              <Image
                class="photo"
                src={pillar.src}
                alt={pillar.alt}
                widths={[640, 960, 1280]}
                sizes="(min-width: 768px) 40vw, 92vw"
              />
            </div>
          </div>
          <ol class="work-stages">
            {pillar.stages.map((stage) => {
              const linkAt =
                stage.linkHref && stage.linkLabel
                  ? stage.body.indexOf(stage.linkLabel)
                  : -1;
              return (
                <li class="work-stage">
                  <h3 class="type-h3">{stage.title}</h3>
                  <p class="type-body mt-sm">
                    {linkAt >= 0 && stage.linkHref && stage.linkLabel ? (
                      <>
                        {stage.body.slice(0, linkAt)}
                        <a href={sitePath(stage.linkHref)}>{stage.linkLabel}</a>
                        {stage.body.slice(linkAt + stage.linkLabel.length)}
                      </>
                    ) : (
                      stage.body
                    )}
                  </p>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }

    <p class="site-wrap pb-2xl">
      <a class="btn-primary" href={sitePath("/book-call/")}>Request a Discovery Call</a>
    </p>
  </main>
  <CtaBanner />
</BaseLayout>
