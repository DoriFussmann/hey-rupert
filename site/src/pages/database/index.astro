---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { sitePath } from "../../lib/url";

const title = "Investor Research & Targeting Database | Rupert";
const description =
  "See how Rupert uses structured investor research to identify VCs, family offices and other capital sources that fit a startup's stage, sector and raise.";

const capabilities = [
  {
    title: "Fit, not volume",
    body: "The dataset is used to narrow a large market into investors whose stage, sector, geography and mandate fit the company being raised for.",
  },
  {
    title: "Structured criteria",
    body: "Research considers investment thesis, check size, financing type and actual activity — not a generic list of names.",
  },
  {
    title: "Used inside the work",
    body: "Founders buy the outcome of that research: a relevant target list and outreach built from it. The database is not a self-serve export product.",
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/database/">
  <main id="main-content" class="flex-1">
    <section class="site-wrap pb-xl pt-2xl lg:pb-2xl lg:pt-3xl">
      <p class="type-label">Our Database</p>
      <h1 class="type-h1 mt-md">
        The research behind every Rupert campaign.
      </h1>
      <p class="type-body-lg mt-lg max-w-prose">
        Rupert works from a structured investor dataset covering venture funds,
        family offices and other relevant capital sources. The database helps
        narrow a large market into investors whose stage, sector, geography and
        mandate fit the company being raised for.
      </p>
    </section>

    <section class="site-wrap section-block rule" aria-labelledby="research-heading">
      <h2 id="research-heading" class="type-h2">
        Built for targeting, not browsing.
      </h2>
      <p class="type-body mt-md max-w-prose">
        The founder is buying the quality of the match and the outreach, not an
        Excel file. Research stays inside the campaign process —
        <a href={sitePath("/how-it-works/")}>see how that process runs</a>.
      </p>
      <ul class="editorial-grid editorial-grid--3 mt-2xl">
        {
          capabilities.map((item) => (
            <li class="editorial-cell">
              <h3 class="type-h3">{item.title}</h3>
              <p class="type-body mt-sm">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <CtaBanner />
</BaseLayout>
