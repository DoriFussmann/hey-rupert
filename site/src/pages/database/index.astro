---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import FaqBlock from "../../components/FaqBlock.astro";
import { sitePath } from "../../lib/url";

const title = "Investor Research and Targeting for Your Raise | Rupert";
const description =
  "Rupert uses investor research to judge fit by thesis, stage, sector, geography, check size and mandate. The database is never sold as a contact list.";

const proofPoints = [
  {
    title: "10,000+ fund offices in the research universe",
    body: "The starting universe. A campaign uses a smaller list, chosen for this company and this raise.",
  },
  {
    title: "Thesis, stage, sector, and mandate",
    body: "Research looks at thesis, stage, sector, geography, check size, and mandate, plus available information about investment activity.",
  },
  {
    title: "Used inside the managed service",
    body: "Investors are selected for relevance to the company and the raise. The database is not offered as a download or a self-service list.",
  },
];

const faqs = [
  {
    question: "What types of investors does Rupert research?",
    answer:
      "Venture funds, family offices, and other capital sources. Selection uses thesis, stage, sector, geography, check size, and mandate. The database does not provide a self-service list or a guarantee that an investor will meet or invest.",
  },
  {
    question: "How does Rupert identify relevant investors?",
    answer:
      "Rupert combines structured investor research with human judgment: mandate, thesis, check size, stage, sector, geography, and available information about investment activity.",
  },
  {
    question: "Can I buy or download Rupert's investor database?",
    answer:
      "No. The research supports Rupert's managed investor outreach service. It is used to build a target list for a campaign. It is not sold as a self-service list or a database export.",
  },
  {
    question: "Do I approve the investor list and outreach?",
    answer:
      "Yes. You review the targeting, the investor list, and the messaging before outreach is sent.",
  },
  {
    question: "How large is Rupert's investor research universe?",
    answer:
      "Rupert's existing company materials describe a research universe of more than 10,000 fund offices. This refers to the broader research universe, not a guarantee that every fund is active, eligible, or appropriate for a particular raise.",
  },
];

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/database/"
  jsonLd={jsonLd}
>
  <main id="main-content" class="flex-1">
    <section class="site-wrap pb-xl pt-2xl lg:pb-2xl lg:pt-3xl">
      <p class="type-label">Our Database</p>
      <h1 class="type-h1 mt-md">
        The research behind every Rupert campaign.
      </h1>
      <p class="type-body-lg mt-lg max-w-prose">
        The investor database is the research Rupert uses to build a target
        list for a managed outreach campaign. It is not sold as a self-service
        list. Research covers venture funds, family offices, and other capital
        sources, and it is narrowed to investors whose thesis, stage, sector,
        geography, check size, and mandate fit the company and the raise.
      </p>
    </section>

    <section class="site-wrap section-block rule" aria-labelledby="fit-heading">
      <h2 id="fit-heading" class="type-h2">
        A research universe built around investor fit
      </h2>
      <p class="type-body mt-md max-w-prose">
        The database records fit. It does not hand over a directory. The points
        below are how a large research universe becomes a list for one raise.
      </p>
      <ul class="editorial-grid editorial-grid--3 mt-2xl">
        {
          proofPoints.map((item) => (
            <li class="editorial-cell">
              <h3 class="type-h3">{item.title}</h3>
              <p class="type-body mt-sm">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="site-wrap section-block rule" aria-labelledby="campaign-heading">
      <h2 id="campaign-heading" class="type-h2">Built into the campaign</h2>
      <p class="type-body mt-md max-w-prose">
        Rupert uses the research to build your target list, write personalized
        outreach, and run follow-up. You review and approve the strategy, the
        list, and the messages before anything is sent.
      </p>
      <p class="type-body mt-md max-w-prose">
        Investor replies come to you. The relationships stay yours. The research
        supports that managed service. It is not a product you buy or export.
      </p>
      <p class="type-body mt-md max-w-prose">
        <a href={sitePath("/how-it-works/")}>See how Rupert runs investor outreach</a>,
        or read about <a href={sitePath("/about/")}>Dori Fussmann</a>, who leads
        the work.
        <a href={sitePath("/book-call/")}>Request a discovery call</a> when you
        are ready to talk through a raise.
      </p>
    </section>

    <section class="site-wrap section-block rule" aria-labelledby="faq-heading">
      <FaqBlock faqs={faqs} bordered={false} />
    </section>
  </main>
  <CtaBanner />
</BaseLayout>
