---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../config/site";

const title = `Terms of Service — ${SITE_NAME}`;
const description = "Rupert's terms of service are being finalized.";
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/terms/"
  robots="noindex, follow"
>
  <main id="main-content" class="site-wrap flex-1 py-2xl lg:py-3xl">
    <h1 class="type-h1">Terms of Service</h1>
    <p class="type-body mt-lg max-w-prose">
      Rupert's terms of service are being finalized.
    </p>
  </main>
</BaseLayout>
