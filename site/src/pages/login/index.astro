---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../config/site";

const title = `Login — ${SITE_NAME}`;
const description =
  "Sign in to the Rupert portal to manage investor outreach campaigns and your founder workspace.";
---

<BaseLayout title={title} description={description} canonicalPath="/login/">
  <main id="main-content" class="site-wrap flex-1 py-2xl lg:py-3xl">
    <h1 class="type-h1">Login</h1>
    <p class="type-body mt-lg max-w-prose">
      Continue to the
      <a href="https://hey-rupert-portal.vercel.app/login">Rupert portal</a>
      to sign in.
    </p>
  </main>
</BaseLayout>
