---
import { getImage, Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import FaqBlock from "../components/FaqBlock.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import { absoluteUrl, sitePath } from "../lib/url";
import type { ImageMetadata } from "astro";
import heroPhoto from "../assets/hero/hero-carousel-1.png";
import doriPortrait from "../assets/team/dori-fussmann/photo.jpg";
import cornellTechLogo from "../assets/logos/cornell-tech.avif";

const logoFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/logos/*.png",
  { eager: true },
);

const clientLogos = [
  { file: "bluemark.png", name: "BlueMark" },
  { file: "guardian-vets.png", name: "GuardianVets" },
  { file: "jbecca.png", name: "jBecca" },
  { file: "lena-health.png", name: "LenaHealth" },
  { file: "natrion.png", name: "Natrion" },
  { file: "pluto-vets.png", name: "PlutoVets" },
  { file: "powder-pics.png", name: "PowderPics" },
  { file: "sorso.png", name: "Sorso" },
  { file: "sunday.png", name: "Sunday" },
  { file: "swift-vets.png", name: "SwiftVets" },
  { file: "the-vets.png", name: "The Vets" },
  { file: "user1st.png", name: "User1st" },
  { file: "vetnio.png", name: "Vetnio" },
  { file: "yourpath.png", name: "YourPath" },
  { file: "sniffi.png", name: "Sniffi" },
  { file: "snout.png", name: "Snout" },
  { file: "reside-health.png", name: "ResideHealth" },
  { file: "dex-world.png", name: "Dex World" },
  { file: "tailplans.png", name: "Tailplans" },
].map((item) => {
  const mod = logoFiles[`../assets/logos/${item.file}`];
  if (!mod) {
    throw new Error(`Missing logo asset: ${item.file}`);
  }
  return { name: item.name, src: mod.default };
});

const title = "Expert-Managed Investor Outreach for Startups | Rupert";
const description =
  "Rupert runs investor research, targeting, personalized outreach and follow-up for founders raising capital. Every reply and investor relationship stays yours.";

const principles = [
  {
    title: "Managed for you",
    body: "Research, targeting, copy and follow-up are handled by Rupert.",
  },
  {
    title: "Every reply is yours",
    body: "Investor conversations go directly to you.",
  },
  {
    title: "No percentage of your raise",
    body: "Rupert is paid for the work, not for ownership of your relationships.",
  },
];

const capabilities = [
  {
    title: "Investor research & targeting",
    body: "Rupert builds a target universe around stage, sector, geography, investment thesis, check size and actual fit.",
  },
  {
    title: "Outreach strategy & writing",
    body: "Messages are written for your company and the investors receiving them — not copied from a generic sequence.",
  },
  {
    title: "Campaign execution & follow-up",
    body: "Rupert runs the outreach and follow-up process with consistency and discipline.",
  },
  {
    title: "Pipeline support",
    body: "You retain visibility into the process and every investor relationship as conversations develop.",
  },
];

const differentiators = [
  {
    title: "Precision over volume",
    body: "The goal is not to contact the most investors. It is to identify and reach investors whose mandate actually fits the company and round.",
  },
  {
    title: "Human judgment",
    body: "Investor selection, messaging and campaign decisions are reviewed by an experienced operator rather than delegated entirely to automation.",
  },
  {
    title: "Founder ownership",
    body: "Every reply and every relationship remains with the founder. Rupert does not sit between you and the investor and does not take a percentage of the raise.",
  },
];

const steps = [
  {
    title: "Understand the raise",
    body: "A direct conversation with Dori about the company, round, story, target investor profile and what has already been tried.",
  },
  {
    title: "Build the campaign",
    body: "Rupert researches the investor universe, creates the target list and writes the outreach. You review the approach before anything goes out.",
  },
  {
    title: "Run the process",
    body: "Campaigns launch, follow-ups are managed, and investor replies come back to you. When conversations develop, Rupert stays involved where useful.",
  },
];

const founderCredentials = [
  "Founder & former CEO, The Vets",
  "CFO, BlueMark",
  "Former investment banking, Citi / Morgan Stanley / Ion Pacific",
  "Mentor, Cornell Tech Runway",
  "Mentor, Yale Tsai CITY",
];

const faqs = [
  {
    question: "Is Rupert a fundraising agency?",
    answer:
      "Rupert is an expert-managed investor outreach service. Rupert researches investors, develops outreach and manages the campaign process, while the founder retains direct ownership of every investor relationship.",
  },
  {
    question: "Does Rupert take a percentage of the raise?",
    answer: "No. Rupert does not take a percentage of capital raised.",
  },
  {
    question: "Does Rupert guarantee funding or investor meetings?",
    answer:
      "No. No credible fundraising service can guarantee that an investor will engage or invest. Rupert's job is to improve the quality and execution of the outreach process.",
  },
  {
    question: "Who is Rupert best suited for?",
    answer:
      "Primarily founders of venture-scale companies preparing for or actively raising Pre-Seed through Series A rounds.",
  },
  {
    question: "Do I approve outreach before it is sent?",
    answer:
      "Yes. Messaging and campaign direction are reviewed with you before outreach begins.",
  },
  {
    question: "Who receives investor replies?",
    answer: "You do. Investor relationships remain yours.",
  },
];

const caseLogo = (file: string) => {
  const mod = logoFiles[`../assets/logos/${file}`];
  if (!mod) {
    throw new Error(`Missing logo asset: ${file}`);
  }
  return mod.default;
};

const caseStudies = [
  {
    name: "The Vets",
    logo: caseLogo("the-vets.png"),
    body: "Founded and led The Vets, a tech-enabled pet healthcare company that later merged with BetterVet.",
  },
  {
    name: "Natrion",
    logo: caseLogo("natrion.png"),
    body: "Served as Fractional CFO during Natrion's latest fundraise.",
  },
  {
    name: "Snout",
    logo: caseLogo("snout.png"),
    body: "Served as Fractional CFO on Snout's $100M financing round.",
    href: "https://www.crowdfundinsider.com/2026/02/259184-pet-care-financing-startup-snout-lands-100m-facility-raises-10m-series-a/",
    linkLabel: "$100M financing round",
  },
  {
    name: "BlueMark",
    logo: caseLogo("bluemark.png"),
    body: "Serves as CFO of BlueMark, an impact-investment intelligence platform.",
  },
  {
    name: "Cornell Tech",
    logo: cornellTechLogo,
    body: "Mentors early-stage founders through Cornell Tech's Runway Startups Program.",
  },
  {
    name: "Yale",
    logo: caseLogo("yale.png"),
    body: "Mentors early-stage founders through Yale's Tsai CITY.",
  },
];

const heroOptimized = await getImage({
  src: heroPhoto,
  width: 1280,
});

const orgId = `${absoluteUrl("/")}#organization`;
const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Expert-Managed Investor Outreach",
    provider: { "@id": orgId },
    serviceType: "Investor outreach",
    description,
    url: absoluteUrl("/"),
    areaServed: "Worldwide",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/"
  jsonLd={jsonLd}
  preloadImage={heroOptimized.src}
>
  <main id="main-content" class="flex-1">
    <section class="site-wrap pb-2xl pt-2xl lg:pb-3xl lg:pt-3xl">
      <div class="grid gap-xl md:grid-cols-12 md:items-center md:gap-lg">
        <div class="hero-reveal md:col-span-6">
          <h1 class="type-display">
            Investor outreach, run by someone who has done the work.
          </h1>
          <p class="type-body-lg mt-lg max-w-prose">
            Rupert finds the investors most likely to fund companies like yours,
            builds the outreach, runs the follow-up, and keeps you in control of
            every conversation.
          </p>
          <p class="mt-xl flex flex-wrap items-center gap-md">
            <a class="btn-primary" href={sitePath("/book-call/")}>Book a call</a>
            <a class="btn-quiet" href="#how-it-works">See how it works</a>
          </p>
          <p class="type-body-sm mt-lg">
            Expert-managed. Every reply comes to you. No percentage of your raise.
          </p>
        </div>
        <div class="hero-reveal md:col-span-6">
          <div class="hero-photo">
            <Image
              class="photo"
              src={heroPhoto}
              alt="A printed pitch deck and pen on a wooden desk in late-afternoon light"
              widths={[640, 960, 1280]}
              sizes="(min-width: 768px) 40vw, 92vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="site-wrap section-block rule reveal" aria-label="How Rupert is run">
      <ul class="principles">
        {
          principles.map((item) => (
            <li class="principle">
              <p class="type-h3">{item.title}</p>
              <p class="type-body mt-sm">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section-block rule reveal" aria-labelledby="clients-heading">
      <div class="site-wrap">
        <p class="type-label" id="clients-heading">
          Selected companies Dori has worked with
        </p>
      </div>
      <div class="mt-xl">
        <LogoMarquee logos={clientLogos} />
      </div>
    </section>

    <section
      id="expert-managed-investor-outreach"
      class="site-wrap section-block rule reveal"
      aria-labelledby="does-heading"
    >
      <p class="type-label">What Rupert does</p>
      <h2 id="does-heading" class="type-h2 mt-md">
        The operational work behind a serious fundraise.
      </h2>
      <p class="type-body-lg mt-lg max-w-prose">
        Most founders know they should be speaking with more relevant investors.
        The hard part is doing the research, building the list, writing the
        outreach, following up consistently, and keeping the process organized
        while still running the company. Rupert handles that work.
      </p>
      <ul class="editorial-grid editorial-grid--2 mt-2xl">
        {
          capabilities.map((item) => (
            <li class="editorial-cell">
              <h3 class="type-h3">{item.title}</h3>
              <p class="type-body mt-sm">{item.body}</p>
            </li>
          ))
        }
      </ul>
      <p class="type-body-sm mt-xl">
        <a href={sitePath("/database/")}>See how Rupert researches investors</a>
      </p>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="why-heading">
      <p class="type-label">Why Rupert</p>
      <h2 id="why-heading" class="type-h2 mt-md">
        Not another fundraising tool.
      </h2>
      <p class="type-body-lg mt-lg max-w-prose">
        Databases give you names. CRMs give you a place to organize them.
        Automated agents give you more activity. Rupert gives you an experienced
        operator running the outreach with you.
      </p>
      <ul class="editorial-grid editorial-grid--3 mt-2xl">
        {
          differentiators.map((item) => (
            <li class="editorial-cell">
              <h3 class="type-h3">{item.title}</h3>
              <p class="type-body mt-sm">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      id="how-it-works"
      class="site-wrap section-block rule reveal"
      aria-labelledby="process-heading"
    >
      <p class="type-label">How it works</p>
      <h2 id="process-heading" class="type-h2 mt-md">
        Three stages. You stay in control.
      </h2>
      <ol class="process-list mt-2xl">
        {
          steps.map((step, index) => (
            <li class="process-item">
              <p class="step-num">{String(index + 1).padStart(2, "0")}</p>
              <div>
                <h3 class="type-h3">{step.title}</h3>
                <p class="type-body mt-sm">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-xl">
        <a class="btn-quiet" href={sitePath("/how-it-works/")}>
          See the full process
        </a>
      </p>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="founder-heading">
      <div class="founder-grid">
        <div class="founder-copy">
          <p class="type-label">Founder</p>
          <h2 id="founder-heading" class="type-h2 mt-md">
            Built by someone who has raised, advised and operated.
          </h2>
          <p class="type-body mt-lg max-w-prose">
            Dori Fussmann is an entrepreneur, finance executive and former
            investment banker who has spent his career on both sides of the
            fundraising table. He founded and led The Vets, previously worked in
            investment banking at Citi, Morgan Stanley and Ion Pacific, and
            today serves as CFO of BlueMark.
          </p>
          <p class="type-body mt-md max-w-prose">
            He also mentors early-stage founders through Cornell Tech's Runway
            Startups Program and Yale's Tsai CITY. Rupert was built to bring the
            discipline of institutional dealmaking to founder-led fundraising
            without the opacity, commissions or middleman dynamic.
          </p>
          <p class="mt-xl">
            <a class="btn-quiet" href={sitePath("/about/")}>About Dori</a>
          </p>
        </div>
        <aside class="founder-panel">
          <div class="founder-panel__top">
            <Image
              class="founder-panel__photo photo"
              src={doriPortrait}
              alt="Photograph of Dori Fussmann"
              width={192}
              height={192}
            />
            <div>
              <h3 class="type-h3 founder-panel__name">Dori Fussmann</h3>
              <p class="type-label mt-xs">Founder</p>
            </div>
          </div>
          <ul class="founder-panel__points">
            {founderCredentials.map((line) => <li>{line}</li>)}
          </ul>
          <p class="founder-panel__links">
            <a href={sitePath("/about/")}>About Dori</a>
            <a
              href="https://www.linkedin.com/in/dori-fussmann-663ba242"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>
          </p>
        </aside>
      </div>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="proof-heading">
      <p class="type-label">Selected work</p>
      <h2 id="proof-heading" class="type-h2 mt-md">
        Companies Dori has built, advised and operated.
      </h2>
      <ul class="case-stack mt-2xl">
        {
          caseStudies.map((item) => (
            <li class="case-card">
              <div class="case-card__logo">
                <Image
                  src={item.logo}
                  alt={item.name}
                  widths={[160, 240, 320]}
                  sizes="120px"
                  inferSize
                />
              </div>
              <p class="case-card__text type-body-sm">
                {
                  item.href && item.linkLabel && item.body.includes(item.linkLabel) ? (
                    <>
                      {item.body.slice(0, item.body.indexOf(item.linkLabel))}
                      <a href={item.href} rel="noopener noreferrer">
                        {item.linkLabel}
                      </a>
                      {item.body.slice(
                        item.body.indexOf(item.linkLabel) + item.linkLabel.length,
                      )}
                    </>
                  ) : (
                    item.body
                  )
                }
              </p>
            </li>
          ))
        }
      </ul>
      <p class="type-body-sm mt-xl">
        Further reading on <a href={sitePath("/articles/")}>investor outreach and fundraising</a>.
      </p>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="faq-heading">
      <FaqBlock faqs={faqs} />
    </section>
  </main>
  <CtaBanner />
</BaseLayout>
