---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import PhotoCarousel from "../components/PhotoCarousel.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import { sitePath } from "../lib/url";
import type { ImageMetadata } from "astro";
import heroCarousel1 from "../assets/hero/hero-carousel-1.png";
import heroCarousel2 from "../assets/hero/hero-carousel-2.png";
import heroCarousel3 from "../assets/hero/hero-carousel-3.png";
import heroCarousel4 from "../assets/hero/hero-carousel-4.png";
import doriPortrait from "../assets/team/dori-fussmann/photo.jpg";
import cornellTechLogo from "../assets/logos/cornell-tech.avif";

const logoFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/logos/*.png",
  { eager: true },
);

const clientLogos = [
  { file: "bluemark.png", name: "BlueMark" },
  { file: "guardian-vets.png", name: "GuardianVets" },
  { file: "jbecca.png", name: "jBecca" },
  { file: "lena-health.png", name: "LenaHealth" },
  { file: "natrion.png", name: "Natrion" },
  { file: "pluto-vets.png", name: "PlutoVets" },
  { file: "powder-pics.png", name: "PowderPics" },
  { file: "sorso.png", name: "Sorso" },
  { file: "sunday.png", name: "Sunday" },
  { file: "swift-vets.png", name: "SwiftVets" },
  { file: "the-vets.png", name: "The Vets" },
  { file: "user1st.png", name: "User1st" },
  { file: "vetnio.png", name: "Vetnio" },
  { file: "yourpath.png", name: "YourPath" },
  { file: "sniffi.png", name: "Sniffi" },
  { file: "snout.png", name: "Snout" },
  { file: "reside-health.png", name: "ResideHealth" },
  { file: "dex-world.png", name: "Dex World" },
  { file: "tailplans.png", name: "Tailplans" },
].map((item) => {
  const mod = logoFiles[`../assets/logos/${item.file}`];
  if (!mod) {
    throw new Error(`Missing logo asset: ${item.file}`);
  }
  return { name: item.name, src: mod.default };
});

const title =
  "Rupert — Investor Outreach & Fundraising Matchmaking for Founders";
const description =
  "Rupert helps founders reach investors most likely to fund them. Outreach is researched, personalized, and managed. You keep every conversation and relationship.";

const capabilities = [
  "End-to-end Fundraising Assistance",
  "Investor Discovery & Mapping",
  "Investor Outreach",
];

const homeStats = [
  { value: "$100M+", label: "Raised" },
  { value: "50+", label: "Startups backed" },
  { value: "10,000+", label: "Investors" },
  { value: "5x", label: "Replies" },
];

const proofStats = [
  { value: "2,400+", label: "Campaigns run" },
  { value: "8,700+", label: "Investor replies" },
  { value: "1,200+", label: "Meetings booked" },
];

const heroFrames = [
  {
    id: "hero-carousel-1",
    src: heroCarousel1,
    alt: "A printed pitch deck and pen on a wooden desk in late-afternoon light",
  },
  {
    id: "hero-carousel-2",
    src: heroCarousel2,
    alt: "Two people in conversation across a small table with papers between them",
  },
  {
    id: "hero-carousel-3",
    src: heroCarousel3,
    alt: "A printed investor list on a desk, a few names circled in pencil",
  },
  {
    id: "hero-carousel-4",
    src: heroCarousel4,
    alt: "A hand writing in a notebook beside a folded document",
  },
];

const steps = [
  {
    title: "Discovery call with Dori",
    body: "A direct 1:1. Capital needs, offer, story, and what you've already tried. No intake form, no junior associate.",
  },
  {
    title: "The match, within 48 hours",
    body: "Your company against 10,000+ VCs, family offices, and angels — filtered by vertical, stage, and geography. The list comes back to you.",
  },
  {
    title: "You approve. Campaigns run. Every reply comes to you.",
    body: "Nothing goes out until you sign off. When a fund engages, Dori stays in it with you — not a name handed over and a disappearance.",
  },
];

const reasons = [
  {
    title: "Precision over spray.",
    body: "Hundreds of matched investors beat thousands of random ones. Every recipient passes a real criteria filter.",
  },
  {
    title: "A human in the loop.",
    body: "This is a managed service. Your campaigns are reviewed and refined with you — not fired blindly by a bot.",
  },
  {
    title: "Full visibility.",
    body: "Every response lands in your client portal. You see it in real time and manage the communication from there.",
  },
];

const testimonials = [
  {
    quote:
      "Rupert found 40 investors we'd never heard of — three of them led our round.",
    name: "Sarah M.",
    firm: "Finova",
    meta: "Seed, London",
  },
  {
    quote:
      "We went from zero investor replies to 12 warm conversations in two weeks.",
    name: "James K.",
    firm: "DataPipe",
    meta: "Pre-seed, NYC",
  },
  {
    quote:
      "The targeting was surgical. Every email felt like it was written for that specific fund.",
    name: "Ana R.",
    firm: "GreenStack",
    meta: "Series A, Berlin",
  },
  {
    quote:
      "Rupert did in three weeks what our last agency didn't manage in three months.",
    name: "Michael T.",
    firm: "Ledgerly",
    meta: "Seed, Austin",
  },
  {
    quote:
      "Having live analytics on every campaign changed how we prioritized follow-ups.",
    name: "Priya D.",
    firm: "Cortex Health",
    meta: "Series A, Toronto",
  },
  {
    quote:
      "The A/B tested pitches actually sounded like they were written by someone who knew the fund.",
    name: "Elena V.",
    firm: "Northloop",
    meta: "Pre-seed, Lisbon",
  },
];

const founderQuote =
  "If something can happen at 50% probability in seven days, I'll get it to 85%, in four days, for less.";

const founderExperience = [
  "Founded The Vets — $100M+ raised, exit via BetterVet",
  "Investment banking at Citi, Morgan Stanley, and Ion Pacific",
  "CFO, BlueMark",
  "Mentor, Cornell Tech Runway and Yale Tsai CITY",
];

const caseLogo = (file: string) => {
  const mod = logoFiles[`../assets/logos/${file}`];
  if (!mod) {
    throw new Error(`Missing logo asset: ${file}`);
  }
  return mod.default;
};

const caseStudies = [
  {
    name: "The Vets",
    logo: caseLogo("the-vets.png"),
    body: "Founded and led The Vets to $25M+ ARR and 250+ employees. Raised $100M+. Exited through the BetterVet merger.",
  },
  {
    name: "Natrion",
    logo: caseLogo("natrion.png"),
    body: "Served as Fractional CFO on Natrion's latest $5M fundraise.",
  },
  {
    name: "Snout",
    logo: caseLogo("snout.png"),
    body: "Served as Fractional CFO on Snout's $100M financing round.",
    href: "https://www.crowdfundinsider.com/2026/02/259184-pet-care-financing-startup-snout-lands-100m-facility-raises-10m-series-a/",
    linkLabel: "$100M financing round",
  },
  {
    name: "BlueMark",
    logo: caseLogo("bluemark.png"),
    body: "Serves as CFO of BlueMark, an impact-investment intelligence platform.",
  },
  {
    name: "Cornell Tech",
    logo: cornellTechLogo,
    body: "Mentoring numerous startups through Cornell Tech's Runway program.",
  },
  {
    name: "Yale",
    logo: caseLogo("yale.png"),
    body: "Mentoring early-stage founders through Yale's Tsai CITY.",
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/">
  <main class="flex-1">
    <section class="site-wrap pb-2xl pt-2xl lg:pb-3xl lg:pt-3xl">
      <div class="grid gap-xl md:grid-cols-12 md:items-center md:gap-lg">
        <div class="hero-reveal md:col-span-6">
          <h1 class="type-display">
            Real Investors. Precise Campaigns. Direct Replies.
          </h1>
          <p class="type-body-lg mt-lg">
            Rupert learns your startup, finds the investors who actually fund
            companies like yours, and gets you into their inbox — with campaigns
            built for each one.
          </p>
          <p class="mt-xl flex flex-wrap items-center gap-md">
            <a class="btn-primary" href={sitePath("/book-call/")}>Book a call</a>
            <a class="btn-quiet" href={sitePath("/how-it-works/")}>
              See how it works →
            </a>
          </p>
          <p class="type-body-sm mt-lg">
            Matched against 10,000+ real VCs, family offices, and angels —
            filtered by their actual investment criteria.
          </p>
        </div>
        <div class="hero-reveal md:col-span-6">
          <PhotoCarousel frames={heroFrames} />
        </div>
      </div>
    </section>

    <section class="site-wrap py-xl lg:py-2xl reveal" aria-label="How Rupert is run">
      <ul class="trust-strip">
        <li class="trust-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="5"></circle>
            <path d="M20 21a8 8 0 0 0-16 0"></path>
          </svg>
          <span class="type-body">Fully managed, no dashboard to learn</span>
        </li>
        <li class="trust-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline>
            <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
          </svg>
          <span class="type-body">Every reply comes to you</span>
        </li>
        <li class="trust-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" x2="5" y1="5" y2="19"></line>
            <circle cx="6.5" cy="6.5" r="2.5"></circle>
            <circle cx="17.5" cy="17.5" r="2.5"></circle>
          </svg>
          <span class="type-body">No percentage of your raise, ever.</span>
        </li>
      </ul>
    </section>

    <section class="py-xl lg:py-2xl reveal" aria-labelledby="clients-heading">
      <div class="site-wrap">
        <h2 id="clients-heading" class="type-label">Select Clients</h2>
      </div>
      <div class="mt-xl">
        <LogoMarquee logos={clientLogos} />
      </div>
    </section>

    <section class="site-wrap py-xl lg:py-2xl reveal" aria-labelledby="founder-heading">
      <div class="founder-grid">
        <div class="founder-copy">
          <p class="type-label">About</p>
          <h2 id="founder-heading" class="type-h2 mt-md">
            Founded by a founder, <em class="founder-heading-accent">for founders.</em>
          </h2>
          <p class="type-body mt-lg max-w-prose">
            Great founders should not have to become full-time fundraisers.
            Dori built Rupert so the operator stays on the company — while the
            list, the sequencing, and the follow-up are handled with the
            discipline of someone who has sat on both sides of the table.
          </p>
          <p class="type-body mt-md max-w-prose">
            Every reply comes to you. No percentage of the raise. No dashboard
            to learn.
          </p>
          <ul class="case-stack mt-xl">
            {
              caseStudies.map((item) => (
                <li class="case-card">
                  <div class="case-card__logo">
                    <Image
                      src={item.logo}
                      alt={item.name}
                      widths={[160, 240, 320]}
                      sizes="120px"
                      inferSize
                    />
                  </div>
                  <p class="case-card__text type-body-sm">
                    {
                      item.href && item.linkLabel && item.body.includes(item.linkLabel) ? (
                        <>
                          {item.body.slice(0, item.body.indexOf(item.linkLabel))}
                          <a href={item.href} rel="noopener noreferrer">
                            {item.linkLabel}
                          </a>
                          {item.body.slice(
                            item.body.indexOf(item.linkLabel) + item.linkLabel.length,
                          )}
                        </>
                      ) : (
                        item.body
                      )
                    }
                  </p>
                </li>
              ))
            }
          </ul>
        </div>

        <aside class="founder-panel">
          <div class="founder-panel__top">
            <Image
              class="founder-panel__photo photo"
              src={doriPortrait}
              alt="Photograph of Dori Fussmann"
              width={192}
              height={192}
            />
            <div>
              <p class="type-h3 founder-panel__name">Dori Fussmann</p>
              <p class="type-label mt-xs">Founder</p>
            </div>
          </div>
          <ul class="founder-panel__points">
            {
              founderExperience.map((line) => (
                <li>{line}</li>
              ))
            }
          </ul>
          <blockquote class="founder-panel__quote">{founderQuote}</blockquote>
          <p class="founder-panel__links">
            <a href={sitePath("/about/")}>Read Dori's full story →</a>
            <a
              href="https://www.linkedin.com/in/dori-fussmann-663ba242"
              rel="noopener noreferrer"
            >
              LinkedIn →
            </a>
          </p>
        </aside>
      </div>
    </section>

    <section class="site-wrap py-xl lg:py-2xl reveal" aria-label="Track record">
      <dl class="grid grid-cols-2 gap-lg md:grid-cols-4">
        {
          homeStats.map((stat) => (
            <div class="surface-card">
              <dt class="type-label">{stat.label}</dt>
              <dd class="stat-value mt-sm">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="site-wrap py-xl lg:py-2xl reveal" aria-labelledby="does-heading">
      <p class="type-label">What Rupert Does</p>
      <h2 id="does-heading" class="type-h2 mt-md">
        From "who do I even email?" to warm investor replies.
      </h2>
      <ol class="mt-2xl grid gap-md">
        {
          steps.map((step, index) => (
            <li class="surface-card grid gap-md md:grid-cols-12 md:gap-lg">
              <p class="step-num md:col-span-2">
                {String(index + 1).padStart(2, "0")}
              </p>
              <div class="md:col-span-10">
                <h3 class="type-h3">{step.title}</h3>
                <p class="type-body mt-sm">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-xl">
        <a class="btn-primary" href={sitePath("/book-call/")}>Book a call</a>
      </p>
    </section>

    <section class="site-wrap py-xl lg:py-2xl reveal" aria-labelledby="why-heading">
      <h2 id="why-heading" class="type-h2">Why it works</h2>
      <ul class="mt-2xl grid gap-xl md:grid-cols-3">
        {
          reasons.map((reason) => (
            <li class="surface-card">
              <h3 class="type-h3">{reason.title}</h3>
              <p class="type-body mt-md">{reason.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="site-wrap py-xl lg:py-2xl reveal" aria-labelledby="proof-heading">
      <h2 id="proof-heading" class="type-h2">Results, in the open</h2>
      <dl class="mt-xl grid gap-xl sm:grid-cols-3">
        {
          proofStats.map((stat) => (
            <div class="surface-card">
              <dt class="type-label">{stat.label}</dt>
              <dd class="stat-value mt-sm">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
      <ul class="mt-2xl grid gap-xl md:grid-cols-2">
        {
          testimonials.map((item) => (
            <li class="surface-card">
              <blockquote class="pull-quote">{item.quote}</blockquote>
              <p class="type-body-sm mt-md">
                {item.name}, {item.firm} · {item.meta}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="services" class="site-wrap py-xl lg:py-2xl reveal">
      <h2 class="type-h2">Services</h2>
      <ul class="mt-xl grid gap-md">
        {
          capabilities.map((item) => (
            <li class="surface-card type-body">{item}</li>
          ))
        }
      </ul>
    </section>
  </main>
  <CtaBanner />
</BaseLayout>
