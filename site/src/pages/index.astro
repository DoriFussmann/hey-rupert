---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import { SITE_NAME } from "../config/site";
import { getPublishedArticles } from "../lib/articles";
import { displayDate } from "../lib/dates";
import { sitePath } from "../lib/url";

const services = (await getCollection("services")).sort(
  (a, b) => a.data.order - b.data.order,
);
const latest = (await getPublishedArticles()).slice(0, 5);
const title = SITE_NAME;
const description =
  "Rupert helps founders connect with the investors most likely to fund their companies. Every outreach campaign is researched, personalized, and managed by experienced operators, while founders retain complete visibility, every conversation, and every investor relationship.";

const clients = [
  "BlueMark",
  "GuardianVets",
  "JBecca",
  "LenaHealth",
  "Natrion",
  "PlutoVets",
  "PowderPics",
  "Sorso",
  "Sunday",
  "SwiftVets",
  "TheVets",
  "User1st",
  "Vetnio",
  "YourPath",
  "Sniffi",
  "Snout",
  "ResideHealth",
];

const capabilities = [
  "End-to-end Fundraising Assistance",
  "Investor Discovery & Mapping",
  "Investor Outreach",
  "Pitch Deck & Data Room Creation",
  "Pitch Deck Preparation",
  "Financial Model Creation",
];

const homeStats = [
  { value: "$100M+", label: "Raised" },
  { value: "50+", label: "Startups backed" },
  { value: "10,000+", label: "Investors" },
  { value: "5x", label: "Replies" },
];

const proofStats = [
  { value: "2,400+", label: "Campaigns run" },
  { value: "8,700+", label: "Investor replies" },
  { value: "1,200+", label: "Meetings booked" },
];

const steps = [
  {
    title: "Rupert understands your business.",
    body: "A short conversation captures your stage, sector, geography, traction, and story — the details an operator actually needs before anyone is emailed.",
  },
  {
    title: "Rupert prepares your pitch.",
    body: "Using the materials you upload — decks, one-pagers, abstracts — messaging is shaped for outreach. Rupert will not create your materials for you, but it puts them to work.",
  },
  {
    title: "Rupert finds your investors.",
    body: "Your profile is matched against 10,000+ VCs, family offices, and angels — filtered by their actual investment criteria, not by name recognition.",
  },
  {
    title: "Rupert builds campaigns per investor type.",
    body: "A seed-stage fintech VC and a family office are different conversations. Each gets a pitch built for how they think, with A/B testing to see what lands.",
  },
  {
    title: "Rupert runs the outreach.",
    body: "Sequences go out, and every open, click, and reply is tracked as it happens. Follow-up is sequenced. Nothing is left sitting in a spreadsheet.",
  },
  {
    title: "You see every conversation.",
    body: "Live campaign analytics and direct investor communication sit in one private workspace. Every reply comes to you. Every relationship stays yours.",
  },
];

const reasons = [
  {
    title: "Precision over spray.",
    body: "Hundreds of matched investors beat thousands of random ones. Every recipient passes a real criteria filter.",
  },
  {
    title: "A human in the loop.",
    body: "This is a managed service. Your campaigns are reviewed and refined with you — not fired blindly by a bot.",
  },
  {
    title: "Full visibility.",
    body: "Opens, clicks, replies, bounces — you see exactly what's working, campaign by campaign.",
  },
];

const testimonials = [
  {
    quote:
      "Rupert found 40 investors we'd never heard of — three of them led our round.",
    name: "Sarah M.",
    firm: "Finova",
    meta: "Seed, London",
  },
  {
    quote:
      "We went from zero investor replies to 12 warm conversations in two weeks.",
    name: "James K.",
    firm: "DataPipe",
    meta: "Pre-seed, NYC",
  },
  {
    quote:
      "The targeting was surgical. Every email felt like it was written for that specific fund.",
    name: "Ana R.",
    firm: "GreenStack",
    meta: "Series A, Berlin",
  },
  {
    quote:
      "Rupert did in three weeks what our last agency didn't manage in three months.",
    name: "Michael T.",
    firm: "Ledgerly",
    meta: "Seed, Austin",
  },
  {
    quote:
      "Having live analytics on every campaign changed how we prioritized follow-ups.",
    name: "Priya D.",
    firm: "Cortex Health",
    meta: "Series A, Toronto",
  },
  {
    quote:
      "The A/B tested pitches actually sounded like they were written by someone who knew the fund.",
    name: "Elena V.",
    firm: "Northloop",
    meta: "Pre-seed, Lisbon",
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/">
  <main class="flex-1">
    <section class="site-wrap pb-2xl pt-2xl lg:pb-3xl lg:pt-3xl">
      <h1 class="type-display hero-reveal">
        Real investors. Real campaigns. Real replies.
      </h1>
      <p class="type-body-lg hero-reveal mt-lg">
        Then meetings, term sheets, and funding — in that order. Rupert studies
        your startup, finds the investors who actually fund companies like
        yours, and reaches them with a campaign built for each one.
      </p>
      <p class="hero-reveal mt-xl flex flex-wrap items-center gap-md">
        <a class="btn-primary" href={sitePath("/book-call/")}>Book a call</a>
        <a class="btn-quiet" href={sitePath("/how-it-works/")}>
          See how it works →
        </a>
      </p>
      <p class="type-body-sm hero-reveal mt-lg">
        Matched against 10,000+ real VCs, family offices, and angels — filtered
        by their actual investment criteria.
      </p>
      <div class="mt-2xl">
        <ImagePlaceholder
          ratio="hero"
          label="Hero still"
          brief="A late-afternoon documentary photograph of a founder at a small desk: a printed deck, a notebook, and a quiet window. Natural light from the left, slightly desaturated, warm matte to match parchment. No handshake, no glass tower, no laptop dashboard taking over the frame. Optional lower-third captions in Inter, not overlaid as UI chrome: Outreach performance, tracked live · Investors, matched and scored · Campaigns, sent and tracked."
        />
      </div>
    </section>

    <section class="site-wrap py-xl lg:py-2xl" aria-labelledby="clients-heading">
      <h2 id="clients-heading" class="type-label">Select Clients</h2>
      <p class="type-body-sm mt-md">
        Image brief: replace each name with that client's wordmark. Single-color
        ink (#1A1A2E) on parchment. Horizontal lockups, no taglines, no drop
        shadows, no full-color versions. Optical size so they sit on one line.
      </p>
      <ul class="mt-lg grid grid-cols-2 gap-sm sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
        {
          clients.map((name) => (
            <li>
              <div class="logo-tile">
                <p class="type-h4">{name}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="site-wrap py-xl lg:py-2xl" aria-labelledby="stop-heading">
      <div class="grid gap-xl md:grid-cols-12 md:gap-lg">
        <div class="md:col-span-7">
          <h2 id="stop-heading" class="type-h2">
            Stop pitching the wrong investors.
          </h2>
          <p class="type-body-lg mt-md">
            Careful matchmaking finds the right ones — and the team at Rupert
            runs the raise with you.
          </p>
          <dl class="mt-xl grid grid-cols-2 gap-lg">
            {
              homeStats.map((stat) => (
                <div>
                  <dt class="type-label">{stat.label}</dt>
                  <dd class="stat-value mt-sm">{stat.value}</dd>
                </div>
              ))
            }
          </dl>
          <ul class="mt-xl">
            {
              capabilities.map((item) => (
                <li class="rule py-md type-body">{item}</li>
              ))
            }
          </ul>
        </div>
        <aside class="md:col-span-5">
          <div class="intake-panel">
            <h3 class="type-h3">Let's get started</h3>
            <p class="type-body mt-md">
              Answer a couple of quick questions so we can personalize your
              call.
            </p>
            <p class="type-label mt-xl">Are you a founder or an investor?</p>
            <p class="mt-md flex flex-wrap gap-sm">
              <span class="choice">Founder</span>
              <span class="choice">Investor</span>
            </p>
            <p class="mt-lg">
              <button class="btn-primary btn-inert" type="button">
                Continue
              </button>
            </p>
          </div>
          <div class="mt-lg">
            <ImagePlaceholder
              ratio="panel"
              label="Intake photograph"
              brief="A one-to-one conversation across a small table. Two people, papers between them, late daylight. Candid, slightly desaturated, no staged 'brainstorm' energy. Crop tight enough that it feels private, not corporate."
            />
          </div>
        </aside>
      </div>
    </section>

    <section class="site-wrap py-xl lg:py-2xl" aria-labelledby="problem-heading">
      <div class="grid gap-xl md:grid-cols-12 md:items-end md:gap-lg">
        <div class="md:col-span-7">
          <p class="type-label">The Problem</p>
          <h2 id="problem-heading" class="type-h2 mt-md">
            Fundraising isn't a pitch problem. It's a targeting problem.
          </h2>
          <p class="type-body-lg mt-lg">
            Most founders email the wrong investors with the same generic pitch
            — and hear nothing back. The investors who would actually fund you
            exist. You just don't know who they are, or what they respond to.
          </p>
        </div>
        <div class="md:col-span-5">
          <ImagePlaceholder
            ratio="portrait"
            label="Problem photograph"
            brief="A printed investor list on a desk, a few names circled in pencil, the rest untouched. Architectural detail around it — a window edge, a lamp, warm paper. No person required. Analog, quiet, specific."
          />
        </div>
      </div>
    </section>

    <section class="site-wrap py-xl lg:py-2xl" aria-labelledby="database-heading">
      <p class="type-label">The Database</p>
      <h2 id="database-heading" class="type-h2 mt-md">
        Whatever you're building, there's an investor in it for you.
      </h2>
      <p class="type-body-lg mt-lg">
        Rupert is built on one of the industry's most complete venture capital
        and private equity databases — covering every stage, sector, and
        geography, so the right investor for your startup is always in reach.
      </p>
      <dl class="mt-2xl grid gap-xl sm:grid-cols-3">
        <div class="rule pt-lg">
          <dt class="type-label">Active investors tracked</dt>
          <dd class="stat-value mt-sm">10,000+</dd>
        </div>
        <div class="rule pt-lg">
          <dt class="type-label">Direct executive emails</dt>
          <dd class="stat-value mt-sm">55,650+</dd>
        </div>
        <div class="rule pt-lg">
          <dt class="type-label">Updated every year</dt>
          <dd class="stat-value mt-sm">2x</dd>
        </div>
      </dl>
      <ul class="mt-2xl grid gap-md md:grid-cols-3">
        <li class="rule pt-lg type-body">
          Geography and industry preference
        </li>
        <li class="rule pt-lg type-body">
          Investment stage and financing type
        </li>
        <li class="rule pt-lg type-body">
          Verified executive contact details
        </li>
      </ul>
      <p class="mt-xl">
        <a class="btn-quiet" href={sitePath("/database/")}>
          See the dataset →
        </a>
      </p>
    </section>

    <section class="site-wrap py-xl lg:py-2xl" aria-labelledby="does-heading">
      <p class="type-label">What Rupert Does</p>
      <h2 id="does-heading" class="type-h2 mt-md">
        From "who do I even email?" to warm investor replies.
      </h2>
      <ol class="mt-2xl">
        {
          steps.map((step, index) => (
            <li class="rule grid gap-md py-xl md:grid-cols-12 md:gap-lg">
              <p class="step-num md:col-span-2">
                {String(index + 1).padStart(2, "0")}
              </p>
              <div class="md:col-span-10">
                <h3 class="type-h3">{step.title}</h3>
                <p class="type-body mt-sm">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-xl">
        <a class="btn-primary" href={sitePath("/book-call/")}>Book a call</a>
      </p>
    </section>

    <section class="site-wrap py-xl lg:py-2xl" aria-labelledby="why-heading">
      <h2 id="why-heading" class="type-h2">Why it works</h2>
      <ul class="mt-2xl grid gap-xl md:grid-cols-3">
        {
          reasons.map((reason) => (
            <li class="rule-accent pt-lg">
              <h3 class="type-h3">{reason.title}</h3>
              <p class="type-body mt-md">{reason.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="site-wrap py-xl lg:py-2xl" aria-labelledby="proof-heading">
      <h2 id="proof-heading" class="type-h2">Results, in the open</h2>
      <dl class="mt-xl grid gap-xl sm:grid-cols-3">
        {
          proofStats.map((stat) => (
            <div>
              <dt class="type-label">{stat.label}</dt>
              <dd class="stat-value mt-sm">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
      <ul class="mt-2xl grid gap-xl md:grid-cols-2">
        {
          testimonials.map((item) => (
            <li class="rule pt-xl">
              <blockquote class="pull-quote">{item.quote}</blockquote>
              <p class="type-body-sm mt-md">
                {item.name}, {item.firm} · {item.meta}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="services" class="site-wrap py-xl lg:py-2xl">
      <h2 class="type-h2">Services</h2>
      {
        services.map((service) => (
          <section
            id={service.data.slug}
            class="rule mt-lg grid gap-md pt-lg md:grid-cols-12 md:gap-lg"
          >
            <h3 class="type-h3 md:col-span-4">{service.data.title}</h3>
            <p class="type-body md:col-span-8">{service.data.summary}</p>
          </section>
        ))
      }
    </section>

    <section class="site-wrap py-xl lg:py-2xl">
      <h2 class="type-h2">Latest Articles</h2>
      <ul class="mt-lg">
        {
          latest.map((article) => (
            <li class="rule">
              <article class="grid gap-sm py-lg md:grid-cols-12 md:gap-lg md:py-xl">
                <p class="md:col-span-4">
                  <time class="type-body-sm" datetime={article.data.date.toISOString()}>
                    {displayDate(article.data.date)}
                  </time>
                </p>
                <div class="md:col-span-8">
                  <h3 class="type-h3">
                    <a class="font-medium no-underline" href={sitePath(`/articles/${article.data.slug}/`)}>
                      {article.data.title}
                    </a>
                  </h3>
                  <p class="type-body mt-sm">{article.data.description}</p>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <CtaBanner />
</BaseLayout>
