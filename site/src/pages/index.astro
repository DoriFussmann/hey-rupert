---
import { getImage, Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import CaseStack from "../components/CaseStack.astro";
import FaqBlock from "../components/FaqBlock.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import { orgId } from "seo-core";
import { DORI_LINKEDIN, SITE_URL } from "../config/site";
import { absoluteUrl, sitePath } from "../lib/url";
import type { ImageMetadata } from "astro";
import heroPhoto from "../assets/hero/hero-carousel-1.png";
import doriPortrait from "../assets/founder/dori-fussmann/photo.jpg";
import linkedinLogo from "../assets/brand/linkedin.png";

const logoFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/logos/*.png",
  { eager: true },
);

const clientLogos = [
  { file: "bluemark.png", name: "BlueMark" },
  { file: "guardian-vets.png", name: "GuardianVets" },
  { file: "jbecca.png", name: "jBecca" },
  { file: "lena-health.png", name: "LenaHealth" },
  { file: "natrion.png", name: "Natrion" },
  { file: "pluto-vets.png", name: "PlutoVets" },
  { file: "powder-pics.png", name: "PowderPics" },
  { file: "sorso.png", name: "Sorso" },
  { file: "sunday.png", name: "Sunday" },
  { file: "swift-vets.png", name: "SwiftVets" },
  { file: "the-vets.png", name: "The Vets" },
  { file: "user1st.png", name: "User1st" },
  { file: "vetnio.png", name: "Vetnio" },
  { file: "yourpath.png", name: "YourPath" },
  { file: "sniffi.png", name: "Sniffi" },
  { file: "snout.png", name: "Snout" },
  { file: "reside-health.png", name: "ResideHealth" },
  { file: "dex-world.png", name: "Dex World" },
  { file: "tailplans.png", name: "Tailplans" },
].map((item) => {
  const mod = logoFiles[`../assets/logos/${item.file}`];
  if (!mod) {
    throw new Error(`Missing logo asset: ${item.file}`);
  }
  return { name: item.name, src: mod.default };
});

const title = "Investor Outreach for Startups | Rupert";
const description =
  "Rupert runs investor research, targeting, and personalized outreach for founders raising capital. You approve the messages. Investor relationships stay yours.";

const experience = [
  { value: "Over $250m", label: "Raised" },
  { value: "Over 50", label: "Clients Engaged" },
  { value: "Over 10,000", label: "Fund Offices To Match With" },
];

const pillars = [
  {
    title: "Discovery & Strategy",
    summary:
      "Map the raise and research the investors who fit before a message is written.",
    items: [
      {
        title: "Understand the Raise",
        body: "Your company, story, round, traction, and where investor outreach should concentrate.",
      },
      {
        title: "Build the Investor Universe",
        body: "A list built on thesis, stage, sector, geography, check size, and genuine fit.",
      },
      {
        title: "Develop the Strategy",
        body: "Positioning, investor segments, and messaging, set before any outreach is written.",
      },
    ],
  },
  {
    title: "Campaign Launch",
    summary:
      "Write personalized outreach, get your approval, then run the campaign and the follow-up.",
    items: [
      {
        title: "Craft the Outreach",
        body: "Messages written for your company and tailored to each investor audience.",
      },
      {
        title: "Review & Approve",
        body: "You review the strategy, the investor list, and the messaging. Nothing is sent without your approval.",
      },
      {
        title: "Launch & Follow Up",
        body: "Rupert sends the approved outreach and manages follow-up. The investor relationships stay yours.",
      },
    ],
  },
  {
    title: "Meetings & Momentum",
    summary:
      "Turn replies into the right conversations. You own every investor relationship.",
    items: [
      {
        title: "Qualify the Interest",
        body: "See who replies, and prioritize the investors showing real interest.",
      },
      {
        title: "Prepare for Meetings",
        body: "Sharpen the story and the questions that investor is likely to ask.",
      },
      {
        title: "Manage the Process",
        body: "Rupert helps with follow-up and next steps. You own the investor relationships.",
      },
    ],
  },
];

const faqs = [
  {
    question: "Is Rupert a fundraising agency?",
    answer:
      "Rupert is an expert-managed investor outreach service for founders raising capital. Rupert researches investors, writes personalized outreach, and runs follow-up. You approve the work, and you keep every investor relationship.",
  },
  {
    question: "Does Rupert take a percentage of the raise?",
    answer: "No. Rupert does not take a percentage of capital raised.",
  },
  {
    question: "Does Rupert guarantee funding or investor meetings?",
    answer:
      "No. Rupert does not guarantee funding or investor meetings. The work is investor research, targeting, personalized outreach, and follow-up, with your approval before anything is sent.",
  },
  {
    question: "Who is Rupert best suited for?",
    answer:
      "Founders of venture-scale companies preparing for or actively raising Pre-Seed through Series A.",
  },
  {
    question: "Do I approve outreach before it is sent?",
    answer:
      "Yes. You review the investor list and the messaging before outreach is sent.",
  },
  {
    question: "Who receives investor replies?",
    answer: "You do. Investor replies come to you, and the investor relationships stay yours.",
  },
];

const heroOptimized = await getImage({
  src: heroPhoto,
  width: 1280,
});

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Expert-Managed Investor Outreach",
    provider: { "@id": orgId(SITE_URL) },
    serviceType: "Investor outreach",
    description,
    url: absoluteUrl("/"),
    areaServed: "Worldwide",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/"
  jsonLd={jsonLd}
  preloadImage={heroOptimized.src}
>
  <main id="main-content" class="flex-1">
    <section class="site-wrap pb-lg pt-xl lg:pb-xl lg:pt-2xl">
      <div class="grid gap-xl md:grid-cols-12 md:items-center md:gap-lg">
        <div class="hero-reveal md:col-span-6">
          <h1 class="visually-hidden">Investor Matchmaking. Without the AI Slop</h1>
          <p class="hero-headline" aria-hidden="true">
            Investor Matchmaking.<br />
            Without the
            <span class="hero-typewriter" data-typewriter>
              <span class="hero-typewriter__sizer">AI Hallucinations</span>
              <span class="hero-typewriter__live">
                <span data-typewriter-text>AI Slop</span><span
                  class="hero-typewriter__cursor"></span>
              </span>
            </span>
          </p>
          <p class="type-body mt-lg max-w-prose">
            Rupert runs expert-managed investor outreach for founders raising
            capital. Investors are researched for your company and your raise,
            the messages are written for each audience, and you approve them
            before anything is sent.
          </p>
          <p class="mt-xl flex flex-wrap items-center gap-md">
            <a class="btn-primary" href={sitePath("/book-call/")}>Request a Discovery Call</a>
            <a class="btn-quiet" href="#how-it-works">See how it works</a>
          </p>
        </div>
        <div class="hero-reveal md:col-span-6">
          <div class="hero-photo">
            <Image
              class="photo"
              src={heroPhoto}
              alt="A printed pitch deck and pen on a wooden desk in late-afternoon light"
              widths={[640, 960, 1280]}
              sizes="(min-width: 768px) 40vw, 92vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="site-wrap pt-md pb-lg lg:pt-lg lg:pb-xl reveal" aria-labelledby="clients-heading">
      <p class="type-label" id="clients-heading">Select Clients</p>
      <div class="mt-xl">
        <LogoMarquee logos={clientLogos} />
      </div>
    </section>

    <section class="site-wrap pt-lg pb-xl lg:pt-xl lg:pb-2xl reveal" aria-labelledby="about-heading">
      <div class="founder-grid">
        <div class="founder-copy">
          <p class="type-label">About</p>
          <h2 id="about-heading" class="type-h2 mt-md">
            Built by someone who has raised, advised and operated.
          </h2>
          <p class="type-body mt-lg max-w-prose">
            Dori Fussmann is an entrepreneur, former investment banker and
            finance executive. He founded and led The Vets, serves as Fractional
            CFO to operating companies, and advises founders on fundraising,
            financial planning and go-to-market. Rupert applies that experience
            to investor research and outreach.
          </p>
          <p class="type-body mt-md max-w-prose">
            He mentors early-stage founders through Cornell Tech's Runway
            Startups Program and Yale's Tsai CITY. You approve outreach before
            it is sent, and every investor relationship stays yours.
          </p>
          <p class="mt-xl">
            <a class="btn-quiet" href={sitePath("/about/")}>Dori Fussmann's background</a>
          </p>
        </div>
        <aside class="founder-panel">
          <div class="founder-panel__top">
            <Image
              class="founder-panel__photo photo"
              src={doriPortrait}
              alt="Photograph of Dori Fussmann, founder of Rupert"
              width={192}
              height={192}
            />
            <div class="founder-panel__identity">
              <h3 class="type-h3 founder-panel__name">Dori Fussmann</h3>
              <p class="type-label mt-xs">Founder</p>
              <p class="founder-panel__links">
                <a
                  class="founder-panel__linkedin"
                  href={DORI_LINKEDIN}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Dori Fussmann on LinkedIn"
                >
                  <Image
                    src={linkedinLogo}
                    alt=""
                    width={20}
                    height={20}
                  />
                </a>
              </p>
            </div>
            <button
              type="button"
              class="founder-panel__expand"
              data-case-expand
              aria-expanded="false"
              aria-label="Expand all roles"
            >
              <span class="founder-panel__expand-chevron" aria-hidden="true"></span>
            </button>
          </div>
          <CaseStack />
        </aside>
      </div>
    </section>

    <section
      id="how-it-works"
      class="site-wrap section-block pt-xl pb-xl lg:pt-2xl lg:pb-2xl rule reveal"
      aria-labelledby="process-heading"
    >
      <p class="type-label">How it works</p>
      <h2 id="process-heading" class="type-h2 mt-md">
        You stay in control.
      </h2>
      <ol class="step-stack mt-xl">
        {
          pillars.map((pillar, index) => (
            <li class="step-band">
              <p class="step-script">Step {index + 1}</p>
              <h3 class="type-h2 mt-sm">{pillar.title}</h3>
              <p class="type-body mt-sm max-w-prose">{pillar.summary}</p>
              <div class="step-band__stages">
                {pillar.items.map((item) => (
                  <details class="pillar-item">
                    <summary class="type-h4">{item.title}</summary>
                    <div class="pillar-item__panel">
                      <div class="pillar-item__body">
                        <p class="type-body-sm">{item.body}</p>
                      </div>
                    </div>
                  </details>
                ))}
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-xl">
        <a class="btn-quiet" href={sitePath("/how-it-works/")}>See the three stages of investor outreach</a>
      </p>
    </section>

    <section class="site-wrap section-block pt-xl lg:pt-2xl rule reveal" aria-labelledby="experience-heading">
      <p class="type-label">Our Database & Experience</p>
      <h2 id="experience-heading" class="type-h2 mt-md">
        Investor research and fundraising experience behind every campaign.
      </h2>
      <ul class="experience-grid mt-xl">
        {
          experience.map((item) => (
            <li class="experience-card">
              <p class="experience-card__value">{item.value}</p>
              <p class="type-h4 mt-sm">{item.label}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-xl">
        <a class="btn-quiet" href={sitePath("/database/")}>How Rupert uses investor research</a>
      </p>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="faq-heading">
      <FaqBlock faqs={faqs} bordered={false} />
    </section>
  </main>
  <CtaBanner />
</BaseLayout>

<script>
  const phrases = [
    { text: "AI Slop", color: "#C0392B" },
    { text: "AI Bullshit", color: "#B85C38" },
    { text: "AI Laziness", color: "#C07C2A" },
    { text: "AI Hallucinations", color: "#4A5568" },
    { text: "AI Noise", color: "#B5935A" },
    { text: "AI Spam", color: "#8B3A2F" },
    { text: "AI Fluff", color: "#7A5C28" },
    { text: "AI Hype", color: "#2F6B4F" },
    { text: "AI Garbage", color: "#1A1A2E" },
  ];

  const root = document.querySelector("[data-typewriter]");
  const textEl = root?.querySelector("[data-typewriter-text]");
  if (root instanceof HTMLElement && textEl instanceof HTMLElement) {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const paint = (phrase: { text: string; color: string }, chars?: number) => {
      root.style.setProperty("--typewriter-color", phrase.color);
      textEl.textContent =
        chars === undefined ? phrase.text : phrase.text.slice(0, chars);
    };

    paint(phrases[0]);

    if (!reduceMotion) {
      const typeMs = 70;
      const deleteMs = 40;
      const holdMs = 2000;
      const gapMs = 260;

      let index = 0;
      let chars = phrases[0].text.length;
      let deleting = true;
      let timer: number | undefined;

      const queue = (fn: () => void, delay: number) => {
        if (timer !== undefined) window.clearTimeout(timer);
        timer = window.setTimeout(fn, delay);
      };

      const tick = () => {
        if (document.hidden) {
          queue(tick, holdMs);
          return;
        }

        const phrase = phrases[index];

        if (!deleting) {
          chars += 1;
          paint(phrase, chars);
          if (chars >= phrase.text.length) {
            deleting = true;
            queue(tick, holdMs);
            return;
          }
          queue(tick, typeMs);
          return;
        }

        chars -= 1;
        paint(phrase, chars);
        if (chars <= 0) {
          deleting = false;
          index = (index + 1) % phrases.length;
          queue(tick, gapMs);
          return;
        }
        queue(tick, deleteMs);
      };

      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) queue(tick, 80);
      });

      queue(tick, holdMs);
    }
  }
</script>
