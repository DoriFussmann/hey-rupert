---
import { getImage, Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import FaqBlock from "../components/FaqBlock.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import { DORI_LINKEDIN } from "../config/site";
import { caseStudies } from "../lib/caseStudies";
import { absoluteUrl, sitePath } from "../lib/url";
import type { ImageMetadata } from "astro";
import heroPhoto from "../assets/hero/hero-carousel-1.png";
import doriPortrait from "../assets/team/dori-fussmann/photo.jpg";
import linkedinLogo from "../assets/brand/linkedin.png";

const logoFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/logos/*.png",
  { eager: true },
);

const clientLogos = [
  { file: "bluemark.png", name: "BlueMark" },
  { file: "guardian-vets.png", name: "GuardianVets" },
  { file: "jbecca.png", name: "jBecca" },
  { file: "lena-health.png", name: "LenaHealth" },
  { file: "natrion.png", name: "Natrion" },
  { file: "pluto-vets.png", name: "PlutoVets" },
  { file: "powder-pics.png", name: "PowderPics" },
  { file: "sorso.png", name: "Sorso" },
  { file: "sunday.png", name: "Sunday" },
  { file: "swift-vets.png", name: "SwiftVets" },
  { file: "the-vets.png", name: "The Vets" },
  { file: "user1st.png", name: "User1st" },
  { file: "vetnio.png", name: "Vetnio" },
  { file: "yourpath.png", name: "YourPath" },
  { file: "sniffi.png", name: "Sniffi" },
  { file: "snout.png", name: "Snout" },
  { file: "reside-health.png", name: "ResideHealth" },
  { file: "dex-world.png", name: "Dex World" },
  { file: "tailplans.png", name: "Tailplans" },
].map((item) => {
  const mod = logoFiles[`../assets/logos/${item.file}`];
  if (!mod) {
    throw new Error(`Missing logo asset: ${item.file}`);
  }
  return { name: item.name, src: mod.default };
});

const title = "Expert-Managed Investor Outreach for Startups | Rupert";
const description =
  "Rupert runs investor research, targeting, personalized outreach and follow-up for founders raising capital. Every reply and investor relationship stays yours.";

const experience = [
  { value: "Over $250m", label: "Raised" },
  { value: "Over 50", label: "Clients Engaged" },
  { value: "Over 10,000", label: "Funds To Match With" },
];

const pillars = [
  {
    title: "Discovery & Strategy",
    summary:
      "Map the raise and build a precise investor universe before a single message is written.",
    items: [
      {
        title: "Understand the Raise",
        body: "Your company, story, round, traction, and what makes you fundable.",
      },
      {
        title: "Build the Investor Universe",
        body: "A tailor-made list based on stage, sector, geography, check size, and genuine fit.",
      },
      {
        title: "Develop the Strategy",
        body: "Define the positioning, investor segments, messaging, and campaign approach.",
      },
    ],
  },
  {
    title: "Campaign Launch",
    summary:
      "Write the outreach, get your approval, then run the campaign with disciplined follow-up.",
    items: [
      {
        title: "Craft the Outreach",
        body: "Custom messaging written for your company and tailored to each investor audience.",
      },
      {
        title: "Review & Approve",
        body: "You review the strategy, targets, and messaging. Nothing goes out without your approval.",
      },
      {
        title: "Launch & Follow Up",
        body: "Rupert runs the campaign and manages the follow-up with consistency and discipline.",
      },
    ],
  },
  {
    title: "Meetings & Momentum",
    summary:
      "Turn replies into the right conversations and keep the process moving through the raise.",
    items: [
      {
        title: "Qualify the Interest",
        body: "Identify the investors showing real interest and prioritize the conversations that matter.",
      },
      {
        title: "Prepare for Meetings",
        body: "Sharpen the story, anticipate questions, and prepare for each investor conversation.",
      },
      {
        title: "Manage the Process",
        body: "Keep conversations moving, manage follow-ups, and maintain momentum through the raise.",
      },
    ],
  },
];

const faqs = [
  {
    question: "Is Rupert a fundraising agency?",
    answer:
      "Rupert is an expert-managed investor outreach service. Rupert researches investors, develops outreach and manages the campaign process, while the founder retains direct ownership of every investor relationship.",
  },
  {
    question: "Does Rupert take a percentage of the raise?",
    answer: "No. Rupert does not take a percentage of capital raised.",
  },
  {
    question: "Does Rupert guarantee funding or investor meetings?",
    answer:
      "No. No credible fundraising service can guarantee that an investor will engage or invest. Rupert's job is to improve the quality and execution of the outreach process.",
  },
  {
    question: "Who is Rupert best suited for?",
    answer:
      "Primarily founders of venture-scale companies preparing for or actively raising Pre-Seed through Series A rounds.",
  },
  {
    question: "Do I approve outreach before it is sent?",
    answer:
      "Yes. Messaging and campaign direction are reviewed with you before outreach begins.",
  },
  {
    question: "Who receives investor replies?",
    answer: "You do. Investor relationships remain yours.",
  },
];

const heroOptimized = await getImage({
  src: heroPhoto,
  width: 1280,
});

const orgId = `${absoluteUrl("/")}#organization`;
const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Expert-Managed Investor Outreach",
    provider: { "@id": orgId },
    serviceType: "Investor outreach",
    description,
    url: absoluteUrl("/"),
    areaServed: "Worldwide",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/"
  jsonLd={jsonLd}
  preloadImage={heroOptimized.src}
>
  <main id="main-content" class="flex-1">
    <section class="site-wrap pb-xl pt-2xl lg:pb-2xl lg:pt-3xl">
      <div class="grid gap-xl md:grid-cols-12 md:items-center md:gap-lg">
        <div class="hero-reveal md:col-span-6">
          <h1 class="hero-headline">
            <span aria-hidden="true">
              Investor Matchmaking.<br />
              Without the
              <span class="hero-typewriter" data-typewriter>
                <span class="hero-typewriter__sizer">AI Hallucinations.</span>
                <span class="hero-typewriter__live">
                  <span data-typewriter-text>AI Slop</span>.<span
                    class="hero-typewriter__cursor"></span>
                </span>
              </span>
            </span>
            <span class="visually-hidden">
              Investor Matchmaking. Without the AI Slop.
            </span>
          </h1>
          <p class="type-body mt-lg max-w-prose">
            Rupert builds a tailor-made investor universe around your company
            and your raise — researched and selected with human judgment to find
            the investors who actually make sense.
          </p>
          <p class="mt-xl flex flex-wrap items-center gap-md">
            <a class="btn-primary" href={sitePath("/book-call/")}>Request a Discovery Call</a>
            <a class="btn-quiet" href="#how-it-works">See how it works</a>
          </p>
        </div>
        <div class="hero-reveal md:col-span-6">
          <div class="hero-photo">
            <Image
              class="photo"
              src={heroPhoto}
              alt="A printed pitch deck and pen on a wooden desk in late-afternoon light"
              widths={[640, 960, 1280]}
              sizes="(min-width: 768px) 40vw, 92vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="site-wrap pt-lg pb-2xl lg:pt-xl lg:pb-3xl reveal" aria-labelledby="clients-heading">
      <p class="type-label" id="clients-heading">Select Clients</p>
      <div class="mt-xl">
        <LogoMarquee logos={clientLogos} />
      </div>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="about-heading">
      <div class="founder-grid">
        <div class="founder-copy">
          <p class="type-label">About</p>
          <h2 id="about-heading" class="type-h2 mt-md">
            Built by someone who has raised, advised and operated.
          </h2>
          <p class="type-body mt-lg max-w-prose">
            Dori Fussmann is an entrepreneur, finance executive and former
            investment banker who has spent his career on both sides of the
            fundraising table. He founded and led The Vets, previously worked in
            investment banking at Citi, Morgan Stanley and Ion Pacific, and
            today serves as CFO of BlueMark.
          </p>
          <p class="type-body mt-md max-w-prose">
            He also mentors early-stage founders through Cornell Tech's Runway
            Startups Program and Yale's Tsai CITY. Rupert was built to bring the
            discipline of institutional dealmaking to founder-led fundraising
            without the opacity, commissions or middleman dynamic.
          </p>
          <p class="mt-xl">
            <a class="btn-quiet" href={sitePath("/about/")}>Learn More</a>
          </p>
        </div>
        <aside class="founder-panel">
          <div class="founder-panel__top">
            <Image
              class="founder-panel__photo photo"
              src={doriPortrait}
              alt="Photograph of Dori Fussmann"
              width={192}
              height={192}
            />
            <div>
              <h3 class="type-h3 founder-panel__name">Dori Fussmann</h3>
              <p class="type-label mt-xs">Founder</p>
              <p class="founder-panel__links">
                <a
                  class="founder-panel__linkedin"
                  href={DORI_LINKEDIN}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Dori Fussmann on LinkedIn"
                >
                  <Image
                    src={linkedinLogo}
                    alt=""
                    width={20}
                    height={20}
                  />
                </a>
              </p>
            </div>
          </div>
          <ul class="case-stack case-stack--aside">
            {
              caseStudies.map((item) => (
                <li class="case-card">
                  <div
                    class:list={[
                      "case-card__logo",
                      item.name === "Yale" && "case-card__logo--yale",
                    ]}
                  >
                    <Image
                      src={item.logo}
                      alt={item.name}
                      widths={[160, 240, 320]}
                      sizes="96px"
                      inferSize
                    />
                  </div>
                  <p class="case-card__text type-body-sm">
                    {
                      item.href && item.linkLabel && item.body.includes(item.linkLabel) ? (
                        <>
                          {item.body.slice(0, item.body.indexOf(item.linkLabel))}
                          <a href={item.href} rel="noopener noreferrer">
                            {item.linkLabel}
                          </a>
                          {item.body.slice(
                            item.body.indexOf(item.linkLabel) + item.linkLabel.length,
                          )}
                        </>
                      ) : (
                        item.body
                      )
                    }
                  </p>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </section>

    <section
      id="how-it-works"
      class="site-wrap section-block rule reveal"
      aria-labelledby="process-heading"
    >
      <p class="type-label">How it works</p>
      <h2 id="process-heading" class="type-h2 mt-md">
        You stay in control.
      </h2>
      <ol class="step-stack mt-xl">
        {
          pillars.map((pillar, index) => (
            <li class="step-band">
              <p class="step-script">Step {index + 1}</p>
              <h3 class="type-h2 mt-sm">{pillar.title}</h3>
              <p class="type-body mt-sm max-w-prose">{pillar.summary}</p>
              <div class="step-band__stages">
                {pillar.items.map((item) => (
                  <details class="pillar-item">
                    <summary class="type-h4">{item.title}</summary>
                    <div class="pillar-item__panel">
                      <div class="pillar-item__body">
                        <p class="type-body-sm">{item.body}</p>
                      </div>
                    </div>
                  </details>
                ))}
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-xl">
        <a class="btn-quiet" href={sitePath("/how-it-works/")}>Learn More</a>
      </p>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="experience-heading">
      <p class="type-label">Our Database & Experience</p>
      <h2 id="experience-heading" class="type-h2 mt-md">
        The research and track record behind every campaign.
      </h2>
      <ul class="experience-grid mt-xl">
        {
          experience.map((item) => (
            <li class="experience-card">
              <p class="experience-card__value">{item.value}</p>
              <p class="type-h4 mt-sm">{item.label}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-xl">
        <a class="btn-quiet" href={sitePath("/database/")}>Learn More</a>
      </p>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="faq-heading">
      <FaqBlock faqs={faqs} bordered={false} />
    </section>
  </main>
  <CtaBanner />
</BaseLayout>

<script>
  const phrases = [
    { text: "AI Slop", color: "#C0392B" },
    { text: "AI Bullshit", color: "#B85C38" },
    { text: "AI Laziness", color: "#C07C2A" },
    { text: "AI Hallucinations", color: "#4A5568" },
    { text: "AI Noise", color: "#B5935A" },
    { text: "AI Spam", color: "#8B3A2F" },
    { text: "AI Fluff", color: "#7A5C28" },
    { text: "AI Hype", color: "#2F6B4F" },
    { text: "AI Garbage", color: "#1A1A2E" },
  ];

  const root = document.querySelector("[data-typewriter]");
  const textEl = root?.querySelector("[data-typewriter-text]");
  if (root instanceof HTMLElement && textEl instanceof HTMLElement) {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const paint = (phrase: { text: string; color: string }, chars?: number) => {
      root.style.setProperty("--typewriter-color", phrase.color);
      textEl.textContent =
        chars === undefined ? phrase.text : phrase.text.slice(0, chars);
    };

    paint(phrases[0]);

    if (!reduceMotion) {
      const typeMs = 70;
      const deleteMs = 40;
      const holdMs = 2000;
      const gapMs = 260;

      let index = 0;
      let chars = phrases[0].text.length;
      let deleting = true;
      let timer: number | undefined;

      const queue = (fn: () => void, delay: number) => {
        if (timer !== undefined) window.clearTimeout(timer);
        timer = window.setTimeout(fn, delay);
      };

      const tick = () => {
        if (document.hidden) {
          queue(tick, holdMs);
          return;
        }

        const phrase = phrases[index];

        if (!deleting) {
          chars += 1;
          paint(phrase, chars);
          if (chars >= phrase.text.length) {
            deleting = true;
            queue(tick, holdMs);
            return;
          }
          queue(tick, typeMs);
          return;
        }

        chars -= 1;
        paint(phrase, chars);
        if (chars <= 0) {
          deleting = false;
          index = (index + 1) % phrases.length;
          queue(tick, gapMs);
          return;
        }
        queue(tick, deleteMs);
      };

      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) queue(tick, 80);
      });

      queue(tick, holdMs);
    }
  }
</script>
