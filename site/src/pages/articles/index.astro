---
import ArticleList from "../../components/ArticleList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../config/site";
import { getPublishedArticles } from "../../lib/articles";

const articles = await getPublishedArticles();
const topics = [
  ...new Set(
    articles
      .map((article) => article.data.pillarKeyword?.trim())
      .filter((value): value is string => Boolean(value)),
  ),
].sort((a, b) => a.localeCompare(b));
const title = `Articles — ${SITE_NAME}`;
const description =
  "Articles from Rupert on founder-led fundraising, investor outreach, and keeping ownership of every relationship.";
---

<BaseLayout title={title} description={description} canonicalPath="/articles/">
  <main class="site-wrap flex-1 py-xl lg:py-2xl">
    <h1 class="type-h1">Articles</h1>
    {/*
      Pagination was removed so title + topic filters can run against the full
      catalog. Revisit with conditional pagination before the list grows past
      ~30–40 articles.
    */}
    <form class="article-filters" id="article-filters" role="search">
      <div class="filter-field">
        <label class="type-label" for="article-search">Search</label>
        <div class="filter-control">
          <input
            id="article-search"
            type="search"
            name="q"
            placeholder="Filter by title"
            autocomplete="off"
          />
          <button type="button" id="article-search-clear" hidden>Clear</button>
        </div>
      </div>
      <div class="filter-field filter-field--topics">
        <p class="type-label" id="article-topic-label">Topic</p>
        <div
          class="topic-chips"
          id="article-topic"
          role="radiogroup"
          aria-labelledby="article-topic-label"
        >
          <button
            type="button"
            class="topic-chip is-active"
            role="radio"
            aria-checked="true"
            data-topic=""
          >
            All Topics
          </button>
          {
            topics.map((topic) => (
              <button
                type="button"
                class="topic-chip"
                role="radio"
                aria-checked="false"
                data-topic={topic}
              >
                {topic}
              </button>
            ))
          }
        </div>
      </div>
    </form>
    <p class="type-body mt-xl" id="article-filter-empty" hidden>
      No articles match these filters.
    </p>
    <ArticleList articles={articles} />
  </main>
</BaseLayout>

<script>
  const form = document.getElementById("article-filters");
  const search = document.getElementById("article-search") as HTMLInputElement | null;
  const topicGroup = document.getElementById("article-topic");
  const topicChips = [
    ...document.querySelectorAll<HTMLButtonElement>(".topic-chip"),
  ];
  const searchClear = document.getElementById("article-search-clear");
  const empty = document.getElementById("article-filter-empty");
  const items = [
    ...document.querySelectorAll<HTMLElement>("#article-grid > li"),
  ];

  function currentParams() {
    return new URLSearchParams(window.location.search);
  }

  function selectedTopic() {
    return (
      topicChips.find((chip) => chip.classList.contains("is-active"))
        ?.dataset.topic || ""
    );
  }

  function setTopic(value: string) {
    for (const chip of topicChips) {
      const active = (chip.dataset.topic || "") === value;
      chip.classList.toggle("is-active", active);
      chip.setAttribute("aria-checked", active ? "true" : "false");
      chip.tabIndex = active ? 0 : -1;
    }
  }

  function applyFilters({ push = false } = {}) {
    const query = (search?.value || "").trim().toLowerCase();
    const selected = selectedTopic();
    let visible = 0;

    for (const item of items) {
      const titleMatch =
        !query || (item.dataset.title || "").includes(query);
      const topicMatch = !selected || item.dataset.topic === selected;
      const show = titleMatch && topicMatch;
      item.hidden = !show;
      if (show) visible += 1;
    }

    if (empty) empty.hidden = visible > 0;
    if (searchClear) searchClear.hidden = !query;

    const url = new URL(window.location.href);
    if (query) url.searchParams.set("q", (search?.value || "").trim());
    else url.searchParams.delete("q");
    if (selected) url.searchParams.set("topic", selected);
    else url.searchParams.delete("topic");

    const next = `${url.pathname}${url.search}${url.hash}`;
    const current = `${window.location.pathname}${window.location.search}${window.location.hash}`;
    if (next !== current) {
      history[push ? "pushState" : "replaceState"](null, "", next);
    }
  }

  function syncFromUrl() {
    const params = currentParams();
    if (search) search.value = params.get("q") || "";
    const requested = params.get("topic") || "";
    const match = topicChips.some((chip) => (chip.dataset.topic || "") === requested);
    setTopic(match ? requested : "");
    applyFilters();
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    applyFilters({ push: true });
  });
  search?.addEventListener("input", () => applyFilters());
  topicGroup?.addEventListener("click", (event) => {
    const chip = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>(
      ".topic-chip",
    );
    if (!chip || !topicGroup.contains(chip)) return;
    setTopic(chip.dataset.topic || "");
    applyFilters({ push: true });
  });
  topicGroup?.addEventListener("keydown", (event) => {
    if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown", "Home", "End"].includes(event.key)) {
      return;
    }
    event.preventDefault();
    const current = topicChips.findIndex((chip) => chip.classList.contains("is-active"));
    let next = current < 0 ? 0 : current;
    if (event.key === "Home") next = 0;
    else if (event.key === "End") next = topicChips.length - 1;
    else if (event.key === "ArrowRight" || event.key === "ArrowDown") {
      next = (current + 1) % topicChips.length;
    } else {
      next = (current - 1 + topicChips.length) % topicChips.length;
    }
    const chip = topicChips[next];
    if (!chip) return;
    setTopic(chip.dataset.topic || "");
    chip.focus();
    applyFilters({ push: true });
  });
  searchClear?.addEventListener("click", () => {
    if (search) search.value = "";
    applyFilters({ push: true });
    search?.focus();
  });
  window.addEventListener("popstate", syncFromUrl);
  syncFromUrl();
</script>
