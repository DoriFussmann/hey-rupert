---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../config/site";
import { Content } from "../../legal/privacy.md";

const title = `Privacy Policy — ${SITE_NAME}`;
const description = "How Rupert (The Night Ventures, LLC) collects, uses, shares and protects personal information.";
---

<BaseLayout title={title} description={description} canonicalPath="/privacy/">
  <main id="main-content" class="site-wrap flex-1 py-2xl lg:py-3xl">
    <div>
      <h1 class="type-h1">Privacy Policy</h1>
      <div class="article-body mt-lg">
        <Content />
      </div>
    </div>
  </main>
</BaseLayout>
