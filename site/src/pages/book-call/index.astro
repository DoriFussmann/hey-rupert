---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BOOKING_ENDPOINT } from "../../config/publicEnv";

const title = "Request a Discovery Call | Rupert";
const description =
  "A 30-minute conversation with Dori to understand what you're raising, where you are in the process, and whether Rupert is the right fit.";

const bullets = [
  "Discuss your target investor profile",
  "Understand how Rupert runs outreach",
  "Determine whether the engagement makes sense",
];

const stages = ["Pre-seed", "Seed", "Series A", "Series B+", "Not sure"];
const raising = [
  "Yes, currently raising",
  "Starting in the next 3 months",
  "Just exploring",
];

const formConfigured = Boolean(BOOKING_ENDPOINT);
---

<BaseLayout title={title} description={description} canonicalPath="/book-call/">
  <main id="main-content" class="flex-1">
    <section class="site-wrap grid gap-2xl py-2xl lg:grid-cols-12 lg:gap-lg lg:py-3xl">
      <div class="lg:col-span-6">
        <h1 class="type-h1">Let's talk about your raise.</h1>
        <p class="type-body-lg mt-lg max-w-prose">
          A 30-minute conversation with Dori to understand what you're raising,
          where you are in the process, and whether Rupert is the right fit.
        </p>
        <ul class="mt-xl">
          {
            bullets.map((item) => (
              <li class="rule py-md type-body">{item}</li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-6">
        <form
          class="lead-form"
          id="booking-form"
          method="post"
          action={formConfigured ? BOOKING_ENDPOINT : undefined}
          data-configured={formConfigured ? "true" : "false"}
        >
          <h2 class="type-h2">Tell me about the raise</h2>

          <p class="mt-xl">
            <label class="type-label" for="full-name">Full name</label>
            <input
              class="field-input"
              id="full-name"
              name="name"
              type="text"
              autocomplete="name"
              required
            />
          </p>
          <p class="mt-lg">
            <label class="type-label" for="work-email">Work email</label>
            <input
              class="field-input"
              id="work-email"
              name="email"
              type="email"
              autocomplete="email"
              required
            />
          </p>
          <p class="mt-lg">
            <label class="type-label" for="company">Company</label>
            <input class="field-input" id="company" name="company" type="text" required />
          </p>
          <p class="mt-lg">
            <label class="type-label" for="website">Company website</label>
            <input class="field-input" id="website" name="website" type="text" inputmode="url" />
          </p>
          <p class="mt-lg">
            <label class="type-label" for="stage">Stage</label>
            <select class="field-select" id="stage" name="stage" required>
              <option value="">Select stage</option>
              {stages.map((option) => <option value={option}>{option}</option>)}
            </select>
          </p>
          <p class="mt-lg">
            <label class="type-label" for="raising">Raising now?</label>
            <select class="field-select" id="raising" name="raising" required>
              <option value="">Select timing</option>
              {raising.map((option) => <option value={option}>{option}</option>)}
            </select>
          </p>
          <p class="mt-lg">
            <label class="type-label" for="amount">Amount being raised</label>
            <input class="field-input" id="amount" name="amount" type="text" />
          </p>
          <p class="mt-lg">
            <label class="type-label" for="sector">Sector</label>
            <input class="field-input" id="sector" name="sector" type="text" />
          </p>
          <p class="mt-lg">
            <label class="type-label" for="notes">Optional note</label>
            <textarea class="field-textarea" id="notes" name="notes"></textarea>
          </p>
          <p class="mt-xl">
            <button class="btn-primary" type="submit">
              {formConfigured ? "Submit" : "Request a call"}
            </button>
          </p>
          <p
            class="form-status"
            id="booking-status"
            role="status"
            hidden={formConfigured}
          >
            {
              !formConfigured &&
                "Online booking is not connected yet. The form is ready, but submissions are not being sent until a booking endpoint is configured."
            }
          </p>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById("booking-form");
  const status = document.getElementById("booking-status");
  if (form instanceof HTMLFormElement) {
    const configured = form.dataset.configured === "true";
    form.addEventListener("submit", (event) => {
      if (configured && form.action && form.action !== window.location.href) {
        return;
      }
      event.preventDefault();
      if (status) {
        status.hidden = false;
        status.textContent =
          "Online booking is not connected yet. The form is ready, but submissions are not being sent until a booking endpoint is configured.";
        status.classList.add("form-status--error");
      }
    });
  }
</script>
