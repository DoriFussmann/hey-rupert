---
import { getImage, Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStack from "../../components/CaseStack.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { authorUrl, orgId } from "seo-core";
import { AUTHOR_PATH, DORI_LINKEDIN, SITE_NAME, SITE_URL } from "../../config/site";
import { absoluteFileUrl, absoluteUrl, sitePath } from "../../lib/url";
import doriPortrait from "../../assets/founder/dori-fussmann/photo.jpg";
import linkedinLogo from "../../assets/brand/linkedin.png";

const title = "Dori Fussmann: Banker, CFO and Founder of Rupert | Rupert";
const description =
  "Dori Fussmann is an entrepreneur, former investment banker and finance executive. He founded Rupert to run investor research and outreach for startup founders.";

const media = [
  {
    outlet: "TechCrunch",
    excerpt:
      "The Vets, a tech-enabled pet healthcare platform that provides at-home care, has raised $40 million in seed funding led by Target Global, PICO Venture Partners and Bolt Ventures.",
    context: "January 2022 coverage of The Vets' seed round, naming Dori as co-founder.",
    href: "https://techcrunch.com/2022/01/27/the-vets-a-pet-healthcare-platform-that-provides-at-home-care-raises-40m-led-by-target-global/",
  },
  {
    outlet: "PR Newswire",
    excerpt:
      "The Vets, founded in 2021 by Daniel Sagis, Dori Fussmann and Shmuel Chafets, has gone on to transform pet care by combining technological innovation and at-home care.",
    context: "October 2024 announcement of the merger with BetterVet.",
    href: "https://www.prnewswire.com/news-releases/the-vets-and-bettervet-announce-merger-ushering-in-a-new-era-of-pet-healthcare-302287277.html",
  },
  {
    outlet: "Veterinary Innovation Podcast",
    excerpt:
      "Dori shares his journey from investment banking, through start-ups, to veterinary care — and the work of building a practice that could actually hold a team.",
    context: "Episode: Addressing Mental Well-Being Challenges in Vet Practices.",
    href: "https://veterinaryinnovationpodcast.com/episodes/addressing-mental-well-being-challenges-in-veterinary-practices/",
  },
];

const portrait = await getImage({ src: doriPortrait, width: 800 });
const personId = authorUrl("dori-fussmann", SITE_URL, AUTHOR_PATH);
const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": personId,
    name: "Dori Fussmann",
    jobTitle: "Founder",
    description,
    url: absoluteUrl("/about/"),
    image: absoluteFileUrl(portrait.src),
    worksFor: {
      "@id": orgId(SITE_URL),
      name: SITE_NAME,
    },
    sameAs: [DORI_LINKEDIN],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/about/"
  jsonLd={jsonLd}
>
  <main id="main-content" class="flex-1">
    <section class="site-wrap section-block pt-2xl lg:pt-3xl" aria-labelledby="dori-fussmann">
      <div class="founder-grid founder-grid--about">
        <div class="founder-copy">
          <p class="type-label">About</p>
          <h1 id="dori-fussmann" class="type-h1 mt-md">
            Built by someone who has raised, advised and operated.
          </h1>
          <h2 class="type-h3 mt-xl">An entrepreneur and finance executive</h2>
          <p class="type-body mt-sm max-w-prose">
            Dori Fussmann is an entrepreneur and finance executive. He founded
            Rupert to research investors and run personalized outreach for
            founders raising capital. You approve the list and the messages
            before anything is sent, and the investor relationships stay yours.
            Rupert does not take a percentage of capital raised. The roles below
            are why that work is built around a real raise, not a generic list
            of names.
          </p>
          <h2 class="type-h3 mt-xl">Fractional CFO</h2>
          <p class="type-body mt-sm max-w-prose">
            Fractional CFO roles include BlueMark, Translucent AI, Natrion,
            and Snout. He serves as Fractional CFO of BlueMark, an
            impact-investment intelligence platform. At Natrion he served as
            Fractional CFO during the latest fundraise, working across
            financial planning, investor materials, and close. At Snout he
            served as Fractional CFO on the company's $100M financing round.
            Operating finance is how a raise is planned, modeled, and explained
            to investors. Rupert's investor research starts from that same view
            of the company.
          </p>
          <h2 class="type-h3 mt-xl">Fundraising and strategic finance</h2>
          <p class="type-body mt-sm max-w-prose">
            He is Fundraising &amp; Strategic Finance Advisor to Ambi Robotics
            and Manatee. The work covers financial planning, fundraising
            advisory, and go-to-market strategy. Neither role is a Fractional
            CFO engagement. The distinction matters for outreach: the investor
            list and the message follow the mandate of the raise, and the role
            is named for the work it actually is.
          </p>
          <h2 class="type-h3 mt-xl">Advisory</h2>
          <p class="type-body mt-sm max-w-prose">
            He is an Advisor to Sniffi in India and an Advisor to Swift Vets in
            Australia. These are advisory roles, not finance engagements. They
            are separate from the Fractional CFO work and from the investor
            outreach Rupert runs for clients.
          </p>
          <h2 class="type-h3 mt-xl">Companies founded</h2>
          <p class="type-body mt-sm max-w-prose">
            He is the founder of Rupert and the founder of
            <a href="https://www.inmarketlab.com/" rel="noopener noreferrer" target="_blank">InMarketLab</a>.
            He founded and led The Vets, a technology-enabled home veterinary
            care company that raised institutional capital and later merged with
            BetterVet. Building and financing a company is the other side of
            the table from the banking work: what an investor asks, and what a
            founder has to be ready to answer. That is the standard Rupert uses
            when it researches investors and writes outreach.
          </p>
          <h2 class="type-h3 mt-xl">Investment banking</h2>
          <p class="type-body mt-sm max-w-prose">
            At Citi, Morgan Stanley, and Ion Pacific he advised technology and
            consumer companies on M&amp;A, IPOs, and strategic financing. That
            is the judgment in Rupert's investor research: thesis fit, timing,
            and whether the story holds in a real conversation.
          </p>
          <h2 class="type-h3 mt-xl">Mentoring founders</h2>
          <p class="type-body mt-sm max-w-prose">
            He mentors early-stage founders through Cornell Tech's Runway
            Startups Program and Yale's Tsai CITY, on fundraising, financial
            planning, business models, go-to-market, and positioning. The same
            questions show up in a Rupert campaign: who the raise is for, and
            what the outreach needs to say.
          </p>
          <h2 class="type-h3 mt-xl">Education</h2>
          <p class="type-body mt-sm max-w-prose">
            Dori holds degrees in Accounting and Business Management (B.A.) and
            Law (LL.B.) from IDC Herzliya.
          </p>
          <p class="mt-xl flex flex-wrap items-center gap-md">
            <a class="btn-primary" href={sitePath("/book-call/")}>Request a Discovery Call</a>
            <a class="btn-quiet" href={sitePath("/how-it-works/")}>How Rupert works</a>
          </p>
        </div>
        <aside class="founder-panel">
          <div class="founder-panel__top">
            <Image
              class="founder-panel__photo photo"
              src={doriPortrait}
              alt="Photograph of Dori Fussmann, founder of Rupert"
              width={192}
              height={192}
            />
            <div class="founder-panel__identity">
              <h2 class="type-h3 founder-panel__name">Dori Fussmann</h2>
              <p class="type-label mt-xs">Founder</p>
              <p class="founder-panel__links">
                <a
                  class="founder-panel__linkedin"
                  href={DORI_LINKEDIN}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Dori Fussmann on LinkedIn"
                >
                  <Image src={linkedinLogo} alt="" width={20} height={20} />
                </a>
              </p>
            </div>
            <button
              type="button"
              class="founder-panel__expand"
              data-case-expand
              aria-expanded="false"
              aria-label="Expand all roles"
            >
              <span class="founder-panel__expand-chevron" aria-hidden="true"></span>
            </button>
          </div>
          <CaseStack />
        </aside>
      </div>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="media-heading">
      <p class="type-label">Selected media</p>
      <h2 id="media-heading" class="type-h2 mt-md">
        Coverage from building and operating.
      </h2>
      <ul class="mt-2xl">
        {
          media.map((item) => (
            <li class="media-card">
              <p class="type-label">{item.outlet}</p>
              <blockquote class="media-card__excerpt mt-md">
                {item.excerpt}
              </blockquote>
              <p class="type-body-sm mt-md">{item.context}</p>
              <p class="mt-md">
                <a href={item.href} rel="noopener noreferrer" target="_blank">
                  Read on {item.outlet}
                </a>
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <CtaBanner />
</BaseLayout>
