---
import { getImage, Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { DORI_LINKEDIN, SITE_NAME } from "../../config/site";
import { caseStudies } from "../../lib/caseStudies";
import { absoluteFileUrl, absoluteUrl, sitePath } from "../../lib/url";
import doriPortrait from "../../assets/team/dori-fussmann/photo.jpg";
import linkedinLogo from "../../assets/brand/linkedin.png";

const title = "Dori Fussmann | Founder of Rupert";
const description =
  "Dori Fussmann is an entrepreneur, finance executive and former investment banker who founded Rupert to bring disciplined investor outreach to startup fundraising.";

const media = [
  {
    outlet: "TechCrunch",
    excerpt:
      "The Vets, a tech-enabled pet healthcare platform that provides at-home care, has raised $40 million in seed funding led by Target Global, PICO Venture Partners and Bolt Ventures.",
    context: "January 2022 coverage of The Vets' seed round, naming Dori as co-founder.",
    href: "https://techcrunch.com/2022/01/27/the-vets-a-pet-healthcare-platform-that-provides-at-home-care-raises-40m-led-by-target-global/",
  },
  {
    outlet: "PR Newswire",
    excerpt:
      "The Vets, founded in 2021 by Daniel Sagis, Dori Fussmann and Shmuel Chafets, has gone on to transform pet care by combining technological innovation and at-home care.",
    context: "October 2024 announcement of the merger with BetterVet.",
    href: "https://www.prnewswire.com/news-releases/the-vets-and-bettervet-announce-merger-ushering-in-a-new-era-of-pet-healthcare-302287277.html",
  },
  {
    outlet: "Veterinary Innovation Podcast",
    excerpt:
      "Dori shares his journey from investment banking, through start-ups, to veterinary care — and the work of building a practice that could actually hold a team.",
    context: "Episode: Addressing Mental Well-Being Challenges in Vet Practices.",
    href: "https://veterinaryinnovationpodcast.com/episodes/addressing-mental-well-being-challenges-in-veterinary-practices/",
  },
];

const portrait = await getImage({ src: doriPortrait, width: 800 });
const orgId = `${absoluteUrl("/")}#organization`;
const personId = `${absoluteUrl("/about/")}#dori-fussmann`;
const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": personId,
    name: "Dori Fussmann",
    jobTitle: "Founder",
    description,
    url: absoluteUrl("/about/"),
    image: absoluteFileUrl(portrait.src),
    worksFor: {
      "@id": orgId,
      name: SITE_NAME,
    },
    sameAs: [DORI_LINKEDIN],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/about/"
  jsonLd={jsonLd}
>
  <main id="main-content" class="flex-1">
    <section class="site-wrap section-block pt-2xl lg:pt-3xl" aria-labelledby="dori-fussmann">
      <div class="founder-grid">
        <div class="founder-copy">
          <p class="type-label">About</p>
          <h1 id="dori-fussmann" class="type-h1 mt-md">
            Built by someone who has raised, advised and operated.
          </h1>
          <p class="type-body mt-lg max-w-prose">
            Dori Fussmann is an entrepreneur, finance executive and former
            investment banker who has spent his career on both sides of the
            fundraising table. He founded and led The Vets, previously worked in
            investment banking at Citi, Morgan Stanley and Ion Pacific, and
            today serves as CFO of BlueMark.
          </p>
          <p class="type-body mt-md max-w-prose">
            At Citi, Morgan Stanley and Ion Pacific he advised companies on
            M&A, IPOs and strategic financing across technology and consumer.
            That work taught him how institutional investors actually evaluate a
            raise — thesis fit, timing, and whether the story holds up in a
            real conversation.
          </p>
          <p class="type-body mt-md max-w-prose">
            He later founded and led The Vets, a U.S. home pet-care company
            that raised institutional capital and later merged with BetterVet.
            He has also served as fractional CFO on later-stage financings,
            including Snout's $100M facility, and today runs finance at
            BlueMark, an impact-investment intelligence platform.
          </p>
          <p class="type-body mt-md max-w-prose">
            He mentors early-stage founders through Cornell Tech's Runway
            Startups Program and Yale's Tsai CITY — advising on fundraising,
            business models, go-to-market and positioning. Rupert was built to
            bring the discipline of institutional dealmaking to founder-led
            fundraising without the opacity, commissions or middleman dynamic.
          </p>
          <p class="type-body mt-md max-w-prose">
            Dori holds degrees in Accounting and Business Management (B.A.) and
            Law (LL.B.) from IDC Herzliya.
          </p>
          <p class="mt-xl">
            <a class="btn-primary" href={sitePath("/book-call/")}>Request a Discovery Call</a>
          </p>
        </div>
        <aside class="founder-panel">
          <div class="founder-panel__top">
            <Image
              class="founder-panel__photo photo"
              src={doriPortrait}
              alt="Photograph of Dori Fussmann, founder of Rupert"
              width={192}
              height={192}
            />
            <div>
              <h2 class="type-h3 founder-panel__name">Dori Fussmann</h2>
              <p class="type-label mt-xs">Founder</p>
              <p class="founder-panel__links">
                <a
                  class="founder-panel__linkedin"
                  href={DORI_LINKEDIN}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Dori Fussmann on LinkedIn"
                >
                  <Image src={linkedinLogo} alt="" width={20} height={20} />
                </a>
              </p>
            </div>
          </div>
          <ul class="case-stack case-stack--aside">
            {
              caseStudies.map((item) => (
                <li class="case-card">
                  <div
                    class:list={[
                      "case-card__logo",
                      item.name === "Yale" && "case-card__logo--yale",
                    ]}
                  >
                    <Image
                      src={item.logo}
                      alt={item.name}
                      widths={[160, 240, 320]}
                      sizes="96px"
                      inferSize
                    />
                  </div>
                  <p class="case-card__text type-body-sm">
                    {
                      item.href && item.linkLabel && item.body.includes(item.linkLabel) ? (
                        <>
                          {item.body.slice(0, item.body.indexOf(item.linkLabel))}
                          <a href={item.href} rel="noopener noreferrer">
                            {item.linkLabel}
                          </a>
                          {item.body.slice(
                            item.body.indexOf(item.linkLabel) + item.linkLabel.length,
                          )}
                        </>
                      ) : (
                        item.body
                      )
                    }
                  </p>
                </li>
              ))
            }
          </ul>
        </aside>
      </div>
    </section>

    <section class="site-wrap section-block rule reveal" aria-labelledby="media-heading">
      <p class="type-label">Selected media</p>
      <h2 id="media-heading" class="type-h2 mt-md">
        Coverage from building and operating.
      </h2>
      <ul class="mt-2xl">
        {
          media.map((item) => (
            <li class="media-card">
              <p class="type-label">{item.outlet}</p>
              <blockquote class="media-card__excerpt mt-md">
                {item.excerpt}
              </blockquote>
              <p class="type-body-sm mt-md">{item.context}</p>
              <p class="mt-md">
                <a href={item.href} rel="noopener noreferrer" target="_blank">
                  Read on {item.outlet}
                </a>
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <CtaBanner />
</BaseLayout>
