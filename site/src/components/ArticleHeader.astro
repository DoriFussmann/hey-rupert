---
/**
 * Rupert's article header, rendered in seo-core ArticleLayout's "header" slot:
 * breadcrumbs, category, the page's single <h1>, dates, hero image.
 */
import type { CollectionEntry } from "astro:content";
import { formatDate } from "seo-core";
import { ARTICLES_BASE } from "../config/site";
import ArticleImage from "./ArticleImage.astro";
import Breadcrumbs from "./Breadcrumbs.astro";

interface Props {
  article: CollectionEntry<"articles">;
}

const { data } = Astro.props.article;
const updated = data.updatedDate || data.date;
const showUpdated = Boolean(data.updatedDate) && updated > data.date;
const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: "Articles", href: `/${ARTICLES_BASE}/` },
  { label: data.title },
];
---

<Breadcrumbs items={breadcrumbItems} />
<header class="mt-lg mb-xl">
  <p class="type-label">{data.category}</p>
  <h1 class="type-h1 mt-sm">{data.h1}</h1>
  <p class="type-body-sm mt-md">
    Published on <time datetime={data.date}>{formatDate(data.date)}</time>
    {
      showUpdated && (
        <>
          {" "}
          · Updated on{" "}
          <time datetime={updated}>{formatDate(updated)}</time>
        </>
      )
    }
  </p>
</header>
<div class="media-frame mb-xl">
  <ArticleImage src={data.image} alt={data.imageAlt} loading="eager" />
</div>
