---
import { Image } from "astro:assets";
import { PORTAL_LOGIN_URL, SITE_NAME } from "../config/site";
import { sitePath } from "../lib/url";
import rupertPortrait from "../assets/brand/rupert-portrait.jpg";
---

<header class="site-header">
  <nav class="site-wrap site-header__bar" aria-label="Primary">
    <a class="site-logo" href={sitePath("/")} aria-label={SITE_NAME}>
      <Image
        class="site-logo__mark"
        src={rupertPortrait}
        alt=""
        width={72}
        height={72}
        loading="eager"
      />
    </a>
    <div class="site-nav">
      <a class="nav-link" href={sitePath("/articles/")}>Articles</a>
      <a class="nav-link" href={PORTAL_LOGIN_URL}>Login</a>
    </div>
  </nav>
</header>
