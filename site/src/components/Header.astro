---
import { SITE_NAME } from "../config/site";
import { sitePath } from "../lib/url";
---

<header class="sticky top-0 z-10 border-b border-border bg-background">
  <nav class="site-wrap flex min-h-16 flex-wrap items-center justify-between gap-md py-sm">
    <a class="wordmark" href={sitePath("/")}>{SITE_NAME}</a>
    <span class="flex flex-wrap items-center justify-end">
      <a class="nav-link" href={sitePath("/how-it-works/")}>How It Works</a>
      <a class="nav-link" href={sitePath("/database/")}>Our Database</a>
      <a class="nav-link" href={sitePath("/articles/")}>Articles</a>
      <a class="nav-link" href={sitePath("/team/")}>Team</a>
      <a class="btn-primary btn-primary--nav ml-sm" href={sitePath("/book-call/")}>
        Book a Call
      </a>
    </span>
  </nav>
</header>
