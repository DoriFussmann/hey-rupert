---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface CarouselFrame {
  id: string;
  src?: ImageMetadata | string;
  alt?: string;
  caption?: string;
}

interface Props {
  frames: CarouselFrame[];
  intervalMs?: number;
}

const { frames, intervalMs = 5000 } = Astro.props;
const firstCaption = frames[0]?.caption ?? "";
---

<div
  class="photo-carousel"
  data-interval={intervalMs}
  aria-roledescription="carousel"
  aria-label="Photographs"
>
  <div class="photo-carousel__viewport">
    {
      frames.map((frame, index) => (
        <div
          class:list={["photo-carousel__slide", { "is-active": index === 0 }]}
          data-index={index}
          data-caption={frame.caption ?? ""}
          aria-hidden={index === 0 ? "false" : "true"}
        >
          {
            typeof frame.src === "string" ? (
              <img src={frame.src} alt={frame.alt || frame.id} />
            ) : frame.src ? (
              <Image
                src={frame.src}
                alt={frame.alt || frame.id}
                widths={[640, 960, 1280]}
                sizes="(min-width: 768px) 40vw, 92vw"
              />
            ) : (
              <div class="image-slot image-slot--hero image-slot--empty" role="img" aria-label={frame.id}>
                <span class="image-slot__id">{frame.id}</span>
              </div>
            )
          }
        </div>
      ))
    }
  </div>
  <div class="photo-carousel__controls">
    <button class="photo-carousel__btn" type="button" data-dir="prev" aria-label="Previous photograph">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
    </button>
    <button class="photo-carousel__btn" type="button" data-dir="next" aria-label="Next photograph">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </button>
  </div>
  {firstCaption && (
    <p class="photo-carousel__caption type-body-sm" data-caption aria-live="polite">{firstCaption}</p>
  )}
</div>

<script>
  const carousels = document.querySelectorAll(".photo-carousel");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  carousels.forEach((root) => {
    const slides = Array.from(
      root.querySelectorAll<HTMLElement>(".photo-carousel__slide"),
    );
    const captionEl = root.querySelector<HTMLElement>("[data-caption]");
    if (slides.length === 0) return;

    let index = 0;
    let timer: number | undefined;
    const interval = Number(root.getAttribute("data-interval") || "5000");

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", active ? "false" : "true");
      });
      if (captionEl) {
        captionEl.textContent = slides[index]?.dataset.caption || "";
      }
    };

    const stop = () => {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    const start = () => {
      if (reduceMotion || slides.length < 2) return;
      stop();
      timer = window.setInterval(() => show(index + 1), interval);
    };

    root.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((button) => {
      button.addEventListener("click", () => {
        const dir = button.getAttribute("data-dir") === "prev" ? -1 : 1;
        show(index + dir);
        start();
      });
    });

    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else start();
    });

    start();
  });
</script>
