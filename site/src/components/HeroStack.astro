---
// Home hero, right column: three cards the visitor flips through by hand.
// 1. The person: a short note from the founder.
// 2. The work: one outreach email with an editor's marks on it (illustrative).
// 3. The result: one closed raise from the Case Studies page.
// No autoplay, by design: the hero should read as a person and a service, not
// a product demo. Without JavaScript only the first card shows.
import "@fontsource/caveat/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import doriPortrait from "../assets/founder/dori-fussmann/photo.jpg";
import { sitePath } from "../lib/url";

const logoFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/logos/*.png",
  { eager: true },
);

const logos = [
  { file: "morgan-stanley.png", name: "Morgan Stanley", height: 17 },
  { file: "the-vets.png", name: "The Vets", height: 30 },
  { file: "cornell-tech.png", name: "Cornell Tech", height: 30 },
  { file: "yale.png", name: "Yale", height: 26 },
].map((item) => {
  const mod = logoFiles[`../assets/logos/${item.file}`];
  if (!mod) {
    throw new Error(`Missing logo asset: ${item.file}`);
  }
  return { ...item, src: mod.default };
});

const tabs = ["The person", "The work", "The result"];

// Mirrors the Seed case on the Case Studies page. Keep the two in step.
const result = {
  tag: "Seed · Healthcare · US & Canada",
  title: "A $2M Seed round for a first-time founder.",
  quote:
    "I didn't know where to start. Having a structured, organized approach is what really led to consistent outreach, and to results.",
  quoteBy: "Founder & CEO, healthcare company",
  facts: [
    { value: "50+", label: "investors targeted" },
    { value: "3 months", label: "end to end" },
    { value: "Closed", label: "in full" },
  ],
};
---

<div class="hero-stack" data-hero-stack>
  <div class="hero-stack__cards">
    <article
      class="hero-card is-active"
      data-hero-card
      aria-label="A note from Dori Fussmann, founder of Rupert"
    >
      <div class="hero-card__who">
        <Image
          class="hero-card__photo"
          src={doriPortrait}
          alt="Photograph of Dori Fussmann, founder of Rupert"
          width={128}
          height={128}
        />
        <div>
          <p class="hero-card__name">Dori Fussmann</p>
          <p class="hero-card__role">Founder, Rupert</p>
        </div>
      </div>
      <p class="hero-card__body hero-card__body--lead">
        I've been the banker, the founder and the CFO in the room. Now I run
        investor outreach for founders.<br />
        I learn your business and market, match you with the right investors,
        and we run the outreach together.<br />
        Every step is deliberate, transparent and structured.
      </p>
      <p class="hero-card__body hero-card__cta">Let's talk.</p>
      <ul class="hero-card__foot hero-card__logos" aria-label="Where Dori has worked and mentors">
        {
          logos.map((logo) => (
            <li>
              <Image
                src={logo.src}
                alt={logo.name}
                height={logo.height * 2}
                width={Math.round((logo.src.width / logo.src.height) * logo.height * 2)}
                style={`height:${logo.height}px`}
              />
            </li>
          ))
        }
      </ul>
    </article>

    <article
      class="hero-card hero-card--paper"
      data-hero-card
      aria-label="An outreach email with an editor's notes"
    >
      <p class="hero-card__label">A draft, marked up before you see it</p>
      <div class="hero-mail">
        <p class="hero-mail__meta">To: Elena Park, Partner, Northwind Ventures</p>
        <p class="hero-mail__meta">Subject: <span class="hero-mail__mark">Northfield Labs, two years on</span></p>
        <p class="hero-mail__hand">&uarr; her own deal, up front. She'll open it.</p>
        <p><s>We are an innovative platform disrupting the category.</s></p>
        <p class="hero-mail__hand">cut. Say what customers ask for &darr;</p>
        <p>
          Elena, you backed <span class="hero-mail__mark">Northfield Labs</span> before
          most people understood the category. We're building the version their
          customers keep asking for, and raising a $3M seed.
        </p>
        <p class="hero-mail__close">Worth 20 minutes next week?</p>
      </div>
      <p class="hero-card__foot hero-card__fine">
        Illustrative email and investor. Nothing is sent until you approve it.
      </p>
    </article>

    <article
      class="hero-card"
      data-hero-card
      aria-label="A client raise"
    >
      <p class="hero-card__label">{result.tag}</p>
      <p class="hero-card__title">{result.title}</p>
      <blockquote class="hero-card__quote">
        <p>&ldquo;{result.quote}&rdquo;</p>
        <footer>{result.quoteBy}</footer>
      </blockquote>
      <div class="hero-card__foot hero-card__result">
        <ul class="hero-card__facts">
          {
            result.facts.map((fact) => (
              <li>
                <span class="hero-card__fact-value">{fact.value}</span>
                <span class="hero-card__fact-label">{fact.label}</span>
              </li>
            ))
          }
        </ul>
        <a class="hero-card__link" href={sitePath("/case-studies/")}>All case studies</a>
      </div>
    </article>
  </div>

  <div class="hero-stack__nav" data-hero-nav hidden>
    <div class="hero-stack__tabs" role="group" aria-label="Choose a card">
      {
        tabs.map((tab, index) => (
          <button
            type="button"
            class="hero-stack__tab"
            data-hero-tab
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {tab}
          </button>
        ))
      }
    </div>
    <div class="hero-stack__arrows">
      <button type="button" class="hero-stack__arrow" data-hero-prev aria-label="Previous card">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5" /><path d="m12 19-7-7 7-7" /></svg>
      </button>
      <button type="button" class="hero-stack__arrow" data-hero-next aria-label="Next card">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
      </button>
    </div>
  </div>
</div>

<style>
  .hero-stack {
    --ink: #1a1a2e;
    --body: #2d2d2d;
    --muted: #5c5c5c;
    --line: #e4e2de;
    --accent-text: #7a5c28;
    --accent: #b5935a;
    --pen: #2b4a8b;
    max-width: 520px;
    margin-left: auto;
  }

  /* All three cards share one grid cell, so the stack is always as tall as
     the tallest card and nothing below it moves when the card changes. */
  .hero-stack__cards {
    position: relative;
    display: grid;
    margin-bottom: 12px;
  }

  /* Two card edges showing underneath: there is more than one card here. */
  .hero-stack__cards::before,
  .hero-stack__cards::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: -6px;
    left: 10px;
    right: 10px;
    z-index: 0;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 14px;
  }

  .hero-stack__cards::before {
    bottom: -12px;
    left: 20px;
    right: 20px;
    background: #fbfaf8;
  }

  .hero-card {
    grid-area: 1 / 1;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 28px 32px 24px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow:
      0 1px 2px rgba(26, 26, 46, 0.04),
      0 12px 32px -18px rgba(26, 26, 46, 0.18);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 200ms ease-out,
      visibility 0s linear 200ms;
  }

  .hero-card.is-active {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 200ms ease-out,
      visibility 0s;
  }

  .hero-card--paper {
    background: #fdfcfa;
  }

  .hero-card p {
    margin: 0;
  }

  /* The bottom row of every card sits on the same line. */
  .hero-card__foot {
    margin-top: auto !important;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .hero-card__label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  /* Card 1: the person */
  .hero-card__who {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .hero-card__photo {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 18%;
  }

  .hero-card__name {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink);
  }

  .hero-card__role {
    margin-top: 2px !important;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--muted);
  }

  .hero-card__body {
    margin: 18px 0 20px !important;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--body);
  }

  /* One blank line between the note and "Let's talk." */
  .hero-card__body--lead {
    margin-bottom: 0 !important;
  }

  .hero-card__cta {
    margin-top: 1.65em !important;
  }

  .hero-card__logos {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin: 0;
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 0;
    list-style: none;
  }

  .hero-card__logos li {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .hero-card__logos img {
    width: auto;
    max-width: 100%;
    object-fit: contain;
    opacity: 0.85;
  }

  /* Card 2: the work */
  .hero-mail {
    margin: 12px 0 16px;
    font-family: "IBM Plex Mono", "Courier New", monospace;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--body);
  }

  .hero-mail__meta {
    color: var(--muted);
  }

  .hero-mail s {
    color: #9a9a9a;
    text-decoration-color: var(--pen);
  }

  .hero-mail__mark {
    border-bottom: 2px solid var(--pen);
  }

  .hero-mail__hand {
    margin: 2px 0 2px 16px !important;
    font-family: "Caveat", cursive;
    font-size: 1.3125rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--pen);
  }

  .hero-mail__close {
    margin-top: 8px !important;
  }

  .hero-card__fine {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Card 3: the result */
  .hero-card__title {
    margin-top: 10px !important;
    font-size: 1.375rem;
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .hero-card__quote {
    margin: 16px 0 20px;
    padding: 0 0 0 14px;
    border-left: 2px solid var(--accent);
  }

  .hero-card__quote p {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--body);
  }

  .hero-card__quote footer {
    margin-top: 6px;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .hero-card__result {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 20px;
  }

  .hero-card__facts {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-card__fact-value {
    display: block;
    font-size: 1rem;
    line-height: 1.3;
    color: var(--ink);
  }

  .hero-card__fact-label {
    display: block;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .hero-card__link {
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--accent-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .hero-card__link:hover {
    color: var(--ink);
  }

  /* Navigation */
  .hero-stack__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 8px;
  }

  .hero-stack__nav[hidden] {
    display: none;
  }

  .hero-stack__tabs {
    display: flex;
    gap: 20px;
  }

  .hero-stack__tab {
    appearance: none;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--muted);
    cursor: pointer;
  }

  .hero-stack__tab::after {
    content: "";
    display: block;
    height: 2px;
    margin-top: 6px;
    border-radius: 1px;
    background: transparent;
    transition: background-color 150ms ease-out;
  }

  .hero-stack__tab:hover {
    color: var(--ink);
  }

  .hero-stack__tab[aria-pressed="true"] {
    color: var(--ink);
    font-weight: 500;
  }

  .hero-stack__tab[aria-pressed="true"]::after {
    background: var(--accent);
  }

  .hero-stack__arrows {
    display: flex;
    gap: 8px;
  }

  .hero-stack__arrow {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: #ffffff;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 150ms ease-out;
  }

  .hero-stack__arrow:hover {
    border-color: var(--ink);
  }

  .hero-stack__tab:focus-visible,
  .hero-stack__arrow:focus-visible,
  .hero-card__link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .hero-stack__arrow:focus-visible {
    border-radius: 50%;
  }

  @media (max-width: 767px) {
    .hero-stack {
      max-width: none;
      margin-left: 0;
    }

    .hero-card {
      padding: 22px 20px 20px;
    }

    .hero-mail {
      font-size: 0.75rem;
    }

    .hero-mail__hand {
      margin-left: 8px !important;
      font-size: 1.1875rem;
    }
  }

  @media (max-width: 419px) {
    .hero-card__logos {
      gap: 14px;
    }

    .hero-card__logos img {
      transform: scale(0.85);
      transform-origin: left center;
    }

    .hero-stack__tabs {
      gap: 14px;
    }

    .hero-card__facts {
      gap: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-card,
    .hero-card.is-active {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-hero-stack]").forEach((root) => {
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-hero-card]"));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-hero-tab]"));
    const nav = root.querySelector<HTMLElement>("[data-hero-nav]");
    const deck = root.querySelector<HTMLElement>(".hero-stack__cards");
    if (!nav || !deck || cards.length < 2) return;

    let index = 0;
    const show = (next: number) => {
      index = (next + cards.length) % cards.length;
      cards.forEach((card, i) => {
        card.classList.toggle("is-active", i === index);
        card.inert = i !== index;
      });
      tabs.forEach((tab, i) => tab.setAttribute("aria-pressed", String(i === index)));
    };

    tabs.forEach((tab, i) => tab.addEventListener("click", () => show(i)));
    root.querySelector("[data-hero-prev]")?.addEventListener("click", () => show(index - 1));
    root.querySelector("[data-hero-next]")?.addEventListener("click", () => show(index + 1));

    // Swipe left or right on touch screens.
    let startX = 0;
    let startY = 0;
    deck.addEventListener(
      "touchstart",
      (event) => {
        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
      },
      { passive: true },
    );
    deck.addEventListener(
      "touchend",
      (event) => {
        const dx = event.changedTouches[0].clientX - startX;
        const dy = event.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) {
          show(index + (dx < 0 ? 1 : -1));
        }
      },
      { passive: true },
    );

    nav.hidden = false;
    show(0);
  });
</script>
