---
// Home hero, right column: a short signed note from the founder, with the
// logos of where he has worked and mentors. Static by design: the hero should
// read as a person and a service, not a product demo.
import "@fontsource/great-vibes/latin-400.css";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import doriPortrait from "../assets/founder/dori-fussmann/photo.jpg";

const logoFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/logos/*.png",
  { eager: true },
);

const logos = [
  { file: "morgan-stanley.png", name: "Morgan Stanley", height: 17 },
  { file: "the-vets.png", name: "The Vets", height: 30 },
  { file: "cornell-tech.png", name: "Cornell Tech", height: 30 },
  { file: "yale.png", name: "Yale", height: 26 },
].map((item) => {
  const mod = logoFiles[`../assets/logos/${item.file}`];
  if (!mod) {
    throw new Error(`Missing logo asset: ${item.file}`);
  }
  return { ...item, src: mod.default };
});
---

<aside class="hero-note" aria-label="A note from Dori Fussmann, founder of Rupert">
  <div class="hero-note__top">
    <Image
      class="hero-note__photo"
      src={doriPortrait}
      alt="Photograph of Dori Fussmann, founder of Rupert"
      width={128}
      height={128}
    />
    <div class="hero-note__identity">
      <p class="hero-note__name">Dori Fussmann</p>
      <p class="hero-note__role">Founder, Rupert</p>
    </div>
    <p class="hero-note__signature" aria-hidden="true">Dori</p>
  </div>
  <p class="hero-note__body">
    I've been the banker, the founder and the CFO in the room. Now I run
    investor outreach for founders. A person reviews every investor on your
    list, every email is written for the investor receiving it, and nothing
    goes out until you approve it. Your first call is with me.
  </p>
  <ul class="hero-note__logos" aria-label="Where Dori has worked and mentors">
    {
      logos.map((logo) => (
        <li>
          <Image
            src={logo.src}
            alt={logo.name}
            height={logo.height * 2}
            width={Math.round((logo.src.width / logo.src.height) * logo.height * 2)}
            style={`height:${logo.height}px`}
          />
        </li>
      ))
    }
  </ul>
</aside>

<style>
  .hero-note {
    max-width: 520px;
    margin-left: auto;
    padding: 28px 32px 24px;
    background: #ffffff;
    border: 1px solid #e4e2de;
    border-radius: 14px;
    box-shadow:
      0 1px 2px rgba(26, 26, 46, 0.04),
      0 12px 32px -18px rgba(26, 26, 46, 0.18);
  }

  .hero-note__top {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .hero-note__photo {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 18%;
  }

  .hero-note__identity {
    min-width: 0;
  }

  .hero-note__name {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.3;
    color: #1a1a2e;
  }

  .hero-note__role {
    margin: 2px 0 0;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: #5c5c5c;
  }

  /* Sits in the header row, so it adds no height to the card. */
  .hero-note__signature {
    margin: 0 4px 0 auto;
    font-family: "Great Vibes", cursive;
    font-size: 2rem;
    line-height: 1;
    color: #1a1a2e;
    transform: rotate(-4deg);
  }

  .hero-note__body {
    margin: 18px 0 0;
    font-size: 1rem;
    line-height: 1.65;
    color: #2d2d2d;
  }

  .hero-note__logos {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin: 20px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid #e4e2de;
    list-style: none;
  }

  .hero-note__logos li {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .hero-note__logos img {
    width: auto;
    max-width: 100%;
    object-fit: contain;
    opacity: 0.85;
  }

  @media (max-width: 767px) {
    .hero-note {
      max-width: none;
      margin-left: 0;
      padding: 22px 20px 20px;
    }
  }

  @media (max-width: 419px) {
    .hero-note__logos {
      gap: 14px;
    }

    .hero-note__logos img {
      transform: scale(0.85);
      transform-origin: left center;
    }
  }
</style>
