---
import { getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ArticleImage from "./ArticleImage.astro";
import { displayDate } from "../lib/dates";
import { sitePath } from "../lib/url";

interface Props {
  articles: CollectionEntry<"articles">[];
}

const { articles } = Astro.props;

const tiles = await Promise.all(
  articles.map(async (article) => {
    const author = await getEntry("team", article.data.author);
    return {
      article,
      authorName: author?.data.name ?? article.data.author,
      topic: article.data.pillarKeyword ?? "",
    };
  }),
);
---

<ul class="article-grid mt-xl" id="article-grid">
  {
    tiles.map(({ article, authorName, topic }) => (
      <li
        data-title={article.data.title.toLowerCase()}
        data-topic={topic}
      >
        <article>
          <a
            class="article-tile no-underline"
            href={sitePath(`/articles/${article.data.slug}/`)}
          >
            <div class="media-frame">
              <ArticleImage
                src={article.data.image}
                alt={article.data.imageAlt}
                variant="card"
              />
            </div>
            <h2 class="type-h3 mt-md">{article.data.title}</h2>
            <p class="type-body-sm mt-sm">
              <time datetime={article.data.date.toISOString()}>
                {displayDate(article.data.date)}
              </time>
              <span aria-hidden="true"> · </span>
              {authorName}
            </p>
          </a>
        </article>
      </li>
    ))
  }
</ul>
