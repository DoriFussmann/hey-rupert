---
interface Props {
  faqs: { question: string; answer: string }[];
}

const { faqs } = Astro.props;
---

<section class="rule mt-2xl pt-xl">
  <h2 id="faq-heading" class="type-h2">Frequently asked questions</h2>
  <div class="faq-list mt-lg">
    {
      faqs.map((faq) => (
        <details class="faq-item">
          <summary class="type-h4">{faq.question}</summary>
          <p class="type-body">{faq.answer}</p>
        </details>
      ))
    }
  </div>
</section>
