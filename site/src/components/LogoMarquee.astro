---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface ClientLogo {
  src: ImageMetadata;
  name: string;
}

interface Props {
  logos: ClientLogo[];
}

const { logos } = Astro.props;
const loop = [...logos, ...logos];
---

<div class="logo-marquee">
  <div class="logo-marquee__fade logo-marquee__fade--start"></div>
  <div class="logo-marquee__track">
    {
      loop.map((logo, index) => (
        <div class="logo-marquee__item">
          <Image
            src={logo.src}
            alt={index < logos.length ? logo.name : ""}
            widths={[160, 240, 320]}
            sizes="160px"
            inferSize
          />
        </div>
      ))
    }
  </div>
  <div class="logo-marquee__fade logo-marquee__fade--end"></div>
</div>
