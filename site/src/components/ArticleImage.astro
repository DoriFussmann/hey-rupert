---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  loading?: "eager" | "lazy";
  variant?: "hero" | "card";
}

const { src, alt, loading = "lazy", variant = "hero" } = Astro.props;

const hero = {
  width: 1200,
  height: 675,
  widths: [400, 640, 800, 960, 1200],
  sizes: "(max-width: 767px) calc(100vw - 32px), min(1112px, calc(100vw - 48px))",
};

const card = {
  width: 800,
  height: 450,
  widths: [360, 480, 640, 800],
  sizes:
    "(max-width: 767px) calc(100vw - 64px), (max-width: 1023px) calc(50vw - 56px), 360px",
};

const dims = variant === "card" ? card : hero;
// An eager image is the article's above-the-fold hero and usually its LCP
// element: ask the browser to fetch it ahead of other images.
const fetchpriority = loading === "eager" ? "high" : "auto";
---

<Image
  class="photo"
  src={src}
  alt={alt}
  width={dims.width}
  height={dims.height}
  widths={dims.widths}
  sizes={dims.sizes}
  fit="cover"
  loading={loading}
  fetchpriority={fetchpriority}
/>
