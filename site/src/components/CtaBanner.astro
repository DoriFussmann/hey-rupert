---
import { sitePath } from "../lib/url";
---

<section class="cta-banner" aria-labelledby="cta-banner-heading">
  <div class="site-wrap py-2xl lg:py-3xl">
    <h2 id="cta-banner-heading" class="type-h2">
      Spend your time on the company. Rupert can run the outreach.
    </h2>
    <p class="type-body mt-md max-w-prose">
      30 minutes with Dori to understand your raise, explain how Rupert works,
      and determine whether it is a fit.
    </p>
    <p class="mt-xl">
      <a class="btn-primary" href={sitePath("/book-call/")}>Book a call</a>
    </p>
  </div>
</section>
