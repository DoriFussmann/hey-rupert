---
import { sitePath } from "../lib/url";
---

<section class="cta-banner" aria-labelledby="cta-banner-heading">
  <div class="site-wrap py-2xl lg:py-3xl">
    <p class="type-label">The call</p>
    <h2 id="cta-banner-heading" class="type-h2 mt-md">
      You're raising. Investors are looking. Rupert makes the introduction.
    </h2>
    <p class="type-body mt-md">
      30 minutes to learn how Rupert works and whether it's the right fit for
      your raise.
    </p>
    <p class="mt-xl">
      <a class="btn-primary" href={sitePath("/book-call/")}>Book a call</a>
    </p>
  </div>
</section>
