---
import "@fontsource/inter/latin-300.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "../styles/global.css";
import { abs, orgNode, websiteNode } from "seo-core";
import { DEFAULT_OG_IMAGE, SITE_IDENTITY, SITE_NAME, SITE_URL } from "../config/site";
import { ANALYTICS_ID, SEARCH_CONSOLE_VERIFICATION } from "../config/publicEnv";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

type JsonLdNode = Record<string, unknown>;

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  robots?: string;
  /** BCP 47 ("en-US") or POSIX ("en_US") form; both are accepted. */
  locale?: string;
  ogImage?: string;
  twitterCard?: string;
  ogType?: "website" | "article";
  /**
   * Page JSON-LD: either extra nodes (merged with Organization and WebSite into
   * one @graph) or a complete document with its own @graph (seo-core ArticleLayout).
   */
  jsonLd?: JsonLdNode[] | JsonLdNode;
  /** Markdown mirror of the page (articles). */
  alternateMarkdown?: string;
  articleMeta?: {
    publishedTime: string;
    modifiedTime: string;
    author: string;
    tags: string[];
    section?: string;
  };
  preloadImage?: string;
}

const {
  title,
  description,
  canonicalPath = "/",
  robots = "index, follow",
  locale = "en-US",
  ogImage,
  twitterCard = "summary_large_image",
  ogType = "website",
  jsonLd = [],
  alternateMarkdown,
  articleMeta,
  preloadImage,
} = Astro.props;

if (!title?.trim() || !description?.trim()) {
  throw new Error(
    `BaseLayout requires unique title and description (${Astro.url.pathname})`,
  );
}

const htmlLang = locale.replace("_", "-");
const ogLocale = locale.replace("-", "_");
const canonicalUrl = abs(canonicalPath, SITE_URL);
const ogImageUrl = abs(ogImage || DEFAULT_OG_IMAGE, SITE_URL);

function withoutContext({ "@context": _context, ...node }: JsonLdNode): JsonLdNode {
  return node;
}

const jsonLdDocument = Array.isArray(jsonLd)
  ? {
      "@context": "https://schema.org",
      "@graph": [orgNode(SITE_IDENTITY), websiteNode(SITE_IDENTITY), ...jsonLd.map(withoutContext)],
    }
  : jsonLd;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    {
      ANALYTICS_ID && (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS_ID}`}
          />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ANALYTICS_ID.replace(/[^a-zA-Z0-9-]/g, "")}');`}
          />
        </>
      )
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/logo.png" type="image/png" />
    <meta name="theme-color" content="#FAF9F7" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    {alternateMarkdown && (
      <link rel="alternate" type="text/markdown" href={abs(alternateMarkdown, SITE_URL)} />
    )}
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={abs("/rss.xml", SITE_URL)} />
    {
      SEARCH_CONSOLE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={SEARCH_CONSOLE_VERIFICATION}
        />
      )
    }
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.publishedTime} />
        <meta property="article:modified_time" content={articleMeta.modifiedTime} />
        <meta property="article:author" content={articleMeta.author} />
        {articleMeta.section && <meta property="article:section" content={articleMeta.section} />}
        {articleMeta.tags.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdDocument)} />
  </head>
  <body class="bg-background font-sans text-foreground">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <slot />
    <Footer />
    <script>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (!reduceMotion) {
        const nodes = document.querySelectorAll(".reveal");
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );
        nodes.forEach((node) => observer.observe(node));
      } else {
        document.querySelectorAll(".reveal").forEach((node) => {
          node.classList.add("is-visible");
        });
      }

      document.querySelectorAll(".pillar-item, .faq-item, .case-card").forEach((item) => {
        if (!(item instanceof HTMLDetailsElement)) return;

        if (item.classList.contains("case-card")) {
          item.addEventListener("toggle", () => {
            item.classList.toggle("is-open", item.open);
          });
          return;
        }

        const summary = item.querySelector("summary");
        const panel = item.querySelector(
          ".pillar-item__panel, .faq-item__panel, .case-card__panel",
        );
        if (!(summary instanceof HTMLElement)) return;

        summary.addEventListener("click", (event) => {
          event.preventDefault();
          const isOpen = item.classList.contains("is-open");

          if (reduceMotion) {
            item.open = !isOpen;
            item.classList.toggle("is-open", !isOpen);
            return;
          }

          if (isOpen) {
            item.classList.remove("is-open");
            let closed = false;
            const close = (closeEvent?: Event) => {
              if (closed) return;
              if (closeEvent && closeEvent.target !== panel) return;
              closed = true;
              item.open = false;
              panel?.removeEventListener("transitionend", close);
            };
            panel?.addEventListener("transitionend", close);
            window.setTimeout(close, 360);
          } else {
            item.open = true;
            requestAnimationFrame(() => {
              item.classList.add("is-open");
            });
          }
        });
      });
    </script>
  </body>
</html>
