NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_PORTAL_URL=https://heyrupert.com

# Admin email alerts (Resend). Leave blank to disable email; in-app
# notifications still work.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Rupert <notifications@heyrupert.com>
EMAIL_FROM=
# Comma-separated recipients
ADMIN_NOTIFY_EMAIL=dori@thenightventures.com

# Stripe webhook signing secret (Stripe Dashboard → Developers → Webhooks →
# your endpoint → Signing secret). Endpoint: <portal URL>/api/stripe/webhook,
# event: invoice.paid
STRIPE_WEBHOOK_SECRET=
