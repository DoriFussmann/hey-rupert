NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_PORTAL_URL=https://heyrupert.com

# Admin email alerts (Resend). Leave blank to disable email; in-app
# notifications still work.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Rupert <notifications@heyrupert.com>
EMAIL_FROM=
# Comma-separated recipients
ADMIN_NOTIFY_EMAIL=dori@thenightventures.com

# Stripe webhook signing secret (Stripe Dashboard → Developers → Webhooks →
# your endpoint → Signing secret). Endpoint: <portal URL>/api/stripe/webhook,
# event: invoice.paid
STRIPE_WEBHOOK_SECRET=
# Stripe secret key (Stripe Dashboard → Developers → API keys). Used to void
# a Setup Fee invoice when a signed Service Order is archived. The Service
# Order itself uses a payment link you paste; it does not create invoices.
STRIPE_SECRET_KEY=

# "Book a call" link shown on every client portal page.
NEXT_PUBLIC_BOOK_CALL_URL=https://cal.com/dori-fussmann-lqbqlb/15min

# The 30-minute pre-launch call offered in the Email Copy email.
NEXT_PUBLIC_LAUNCH_CALL_URL=https://cal.com/team-rupert-2zxrkh/30min

# AI Intake Interviewer (Claude). Key from console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Email Verification, step 3 (mailbox check and email finder). Key from
# hunter.io → API. Without it, step 3 marks contacts Unknown.
HUNTER_API_KEY=

# Client reminders (Vercel Cron → /api/cron/reminders, schedule in
# vercel.json). Any long random string; Vercel sends it automatically.
CRON_SECRET=

# Instantly (investor email sending). API key from Instantly → Settings →
# Integrations → API keys, with scopes for accounts, campaigns, leads and
# webhooks. Any long random string for the webhook secret: Go Live registers
# the webhook with it and /api/instantly/webhook checks it.
INSTANTLY_API_KEY=
INSTANTLY_WEBHOOK_SECRET=
