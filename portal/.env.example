NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_PORTAL_URL=https://heyrupert.com

# Admin email alerts (Resend). Leave blank to disable email; in-app
# notifications still work.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Rupert <notifications@heyrupert.com>
EMAIL_FROM=
# Comma-separated recipients
ADMIN_NOTIFY_EMAIL=dori@thenightventures.com

# Stripe webhook signing secret (Stripe Dashboard → Developers → Webhooks →
# your endpoint → Signing secret). Endpoint: <portal URL>/api/stripe/webhook,
# event: invoice.paid
STRIPE_WEBHOOK_SECRET=

# "Book a call" link shown on every client portal page.
NEXT_PUBLIC_BOOK_CALL_URL=https://cal.com/dori-fussmann-lqbqlb/15min

# AI Intake Interviewer (Claude). Key from console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=
