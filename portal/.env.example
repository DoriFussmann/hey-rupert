NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_PORTAL_URL=https://heyrupert.com

# Admin email alerts (Resend). Leave blank to disable email; in-app
# notifications still work.
RESEND_API_KEY=
# Sender of every system email (notifications, Desk alerts, invoices, Service
# Order and NDA links): Hey Rupert <team@heyrupert.com>. The domain must be
# verified in Resend.
EMAIL_FROM=
# Email tracking (optional). Sender on a SEPARATE subdomain verified in
# Resend with open and click tracking switched on, e.g.
# Hey Rupert <team@updates.heyrupert.com>. Client updates go out from it and
# show delivered / opened / clicked in the client's email history. Agreements
# and access links always use EMAIL_FROM, untracked. Blank: nothing is tracked.
EMAIL_FROM_TRACKED=
# Signing secret of the Resend webhook (Resend → Webhooks → your endpoint).
# Endpoint: <portal URL>/api/resend/webhook, events: email.delivered,
# email.opened, email.clicked, email.bounced, email.complained
RESEND_WEBHOOK_SECRET=
# Comma-separated recipients of admin notifications. The FIRST address is also
# the reply-to on every client email and the inbox test sends go to, so it must
# be a mailbox that receives mail. Nothing client-facing uses a
# thenightventures.com address.
ADMIN_NOTIFY_EMAIL=dori@heyrupert.com

# Stripe webhook signing secret (Stripe Dashboard → Developers → Webhooks →
# your endpoint → Signing secret). Endpoint: <portal URL>/api/stripe/webhook,
# event: invoice.paid
STRIPE_WEBHOOK_SECRET=
# Stripe secret key (Stripe Dashboard → Developers → API keys). Used to void
# a Setup Fee invoice when a signed Service Order is archived. The Service
# Order itself uses a payment link you paste; it does not create invoices.
STRIPE_SECRET_KEY=

# "Book a call" (15 min) is set in lib/book-call.ts and prefilled per client.

# The 30-minute pre-launch call offered in the Email Copy email.
NEXT_PUBLIC_LAUNCH_CALL_URL=https://cal.com/team-rupert-2zxrkh/30min

# AI Intake Interviewer (Claude). Key from console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=

# Email Verification, step 3 (mailbox check and email finder). Key from
# hunter.io → API. Without it, step 3 marks contacts Unknown.
HUNTER_API_KEY=

# Client reminders (Vercel Cron → /api/cron/reminders, schedule in
# vercel.json). Any long random string; Vercel sends it automatically.
CRON_SECRET=

# Instantly (investor email sending). API key from Instantly → Settings →
# Integrations → API keys, with scopes for accounts, campaigns, leads and
# webhooks. Any long random string for the webhook secret: Go Live registers
# the webhook with it and /api/instantly/webhook checks it.
INSTANTLY_API_KEY=
INSTANTLY_WEBHOOK_SECRET=
